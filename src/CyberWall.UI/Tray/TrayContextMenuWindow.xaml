                                            <Ellipse Canvas.Left="10.8" Canvas.Top="16.6" Width="2.4" Height="2.4" Fill="{DynamicResource SubTextBrush}"/>
                                        </Canvas>
                                    </Viewbox>
                                </ContentControl>
                                <TextBlock x:Name="HelpText" Text="Ayuda" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Control Grid.Column="1" Style="{StaticResource MenuNavChevron}"/>
                        </Grid>
                    </Button>

                    <!-- More from CyberGems (opens Suite sub-view matching CyberPaste) -->
                    <Button x:Name="SuiteBtn" Style="{StaticResource MenuActionButtonStyle}" HorizontalContentAlignment="Stretch" Click="Suite_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ContentControl Style="{StaticResource MenuRowIcon}">
                                    <Path Data="M 6 3 H 18 L 22 9 L 12 21 L 2 9 Z M 2 9 H 22 M 9 3 L 7 9 L 12 21 L 17 9 L 15 3"
                                          Stroke="{DynamicResource SubTextBrush}" StrokeThickness="1.4"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="14" Height="14" Stretch="Uniform" Fill="Transparent"/>
                                </ContentControl>
                                <TextBlock x:Name="SuiteMenuText" Text="Más de CyberGems" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Control Grid.Column="1" Style="{StaticResource MenuNavChevron}"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- 4. Separator -->
                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="4,4,4,4"/>

                <!-- 5. Exit App -->
                <Button x:Name="ExitBtn" Style="{StaticResource MenuActionButtonStyle}" Click="Exit_Click">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource MenuRowIcon}">
                            <Viewbox Width="13" Height="13" Stretch="Uniform">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 12 2.5 V 11 M 17.6 5.6 A 8.5 8.5 0 1 1 6.4 5.6" Stroke="#EF4444" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                        </ContentControl>
                        <TextBlock x:Name="ExitText" Text="Salir de CyberWall" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- VIEW 2: PAUSE FLOATING ALERTS SUB-VIEW -->
            <StackPanel x:Name="PauseAlertsViewPanel" Visibility="Collapsed">
                <Grid Margin="0,0,2,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PauseBackBtn" Style="{StaticResource SubMenuBackButtonStyle}" Click="SubMenuBack_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 15 18 L 9 12 L 15 6" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="8" Height="10" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PauseBackText" Text="Volver" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Path Data="M 6,8 C 6,4.7 8.7,2 12,2 C 15.3,2 18,4.7 18,8 L 18,13 L 21,17 L 3,17 L 6,13 Z M 10.2,20 C 10.6,21.2 11.2,22 12,22 C 12.8,22 13.4,21.2 13.8,20 M 3,3 L 21,21" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" Fill="Transparent"/>
                        <TextBlock x:Name="PauseSubTitleText" Text="Pausar avisos flotantes" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,6"/>

                <Button x:Name="Pause1hBtn" Style="{StaticResource MenuActionButtonStyle}" Tag="60" Click="PauseDuration_Click">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource MenuRowIcon}">
                            <Path Data="M 12 3 A 9 9 0 1 1 3 12 A 9 9 0 0 1 12 3 M 12 7 V 12 L 15 14" Stroke="{DynamicResource SubTextBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Fill="Transparent"/>
                        </ContentControl>
                        <TextBlock x:Name="Pause1hText" Text="Por 1 hora" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="Pause6hBtn" Style="{StaticResource MenuActionButtonStyle}" Tag="360" Click="PauseDuration_Click">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource MenuRowIcon}">
                            <Path Data="M 12 3 A 9 9 0 1 1 3 12 A 9 9 0 0 1 12 3 M 12 7 V 12 L 15 14" Stroke="{DynamicResource SubTextBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Fill="Transparent"/>
                        </ContentControl>
                        <TextBlock x:Name="Pause6hText" Text="Por 6 horas" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="Pause12hBtn" Style="{StaticResource MenuActionButtonStyle}" Tag="720" Click="PauseDuration_Click">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource MenuRowIcon}">
                            <Path Data="M 12 3 A 9 9 0 1 1 3 12 A 9 9 0 0 1 12 3 M 12 7 V 12 L 15 14" Stroke="{DynamicResource SubTextBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Fill="Transparent"/>
                        </ContentControl>
                        <TextBlock x:Name="Pause12hText" Text="Por 12 horas" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="Pause24hBtn" Style="{StaticResource MenuActionButtonStyle}" Tag="1440" Click="PauseDuration_Click">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource MenuRowIcon}">
                            <Path Data="M 12 3 A 9 9 0 1 1 3 12 A 9 9 0 0 1 12 3 M 12 7 V 12 L 15 14" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Fill="Transparent"/>
                        </ContentControl>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="Pause24hText" Text="Por 24 horas" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="Pause24hSubText" Text="Sugerido" FontSize="10" Foreground="{DynamicResource SubTextBrush}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="4,4,4,4" Opacity="0.6"/>

                <Button x:Name="PausePermanentBtn" Style="{StaticResource MenuActionButtonStyle}" Tag="0" Click="PauseDuration_Click">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource MenuRowIcon}">
                            <Path Data="M 18.178 8 C 19.58 8 21 9.5 21 12 C 21 14.5 19.58 16 18.178 16 C 15.8 16 14 12 12 12 C 10 12 8.2 16 5.822 16 C 4.42 16 3 14.5 3 12 C 3 9.5 4.42 8 5.822 8 C 8.2 8 10 12 12 12 C 14 12 15.8 8 18.178 8 Z" Stroke="{DynamicResource SubTextBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="13" Stretch="Uniform" Fill="Transparent"/>
                        </ContentControl>
                        <TextBlock x:Name="PausePermanentText" Text="Hasta que los reactive" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- VIEW 3: HELP SUB-VIEW -->
            <StackPanel x:Name="HelpViewPanel" Visibility="Collapsed">
                <Grid Margin="0,0,2,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="HelpBackBtn" Style="{StaticResource SubMenuBackButtonStyle}" Click="SubMenuBack_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 15 18 L 9 12 L 15 6" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="8" Height="10" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
