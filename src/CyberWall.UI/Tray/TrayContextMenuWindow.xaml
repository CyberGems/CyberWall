                        </StackPanel>
                    </Button>

                    <!-- Floating Traffic Widget Toggle -->
                    <CheckBox x:Name="WidgetSwitch" Style="{StaticResource MenuActionToggleStyle}" Checked="WidgetSwitch_Changed" Unchecked="WidgetSwitch_Changed">
