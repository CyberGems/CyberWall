                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="14" Height="14" Stretch="Uniform" Fill="Transparent"/>
                            </ContentControl>
                            <TextBlock Text="CyberGems" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,6"/>

                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SuiteAppsPanel"/>
                </ScrollViewer>

                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="4,6,4,6"/>

                <Button x:Name="SuiteMoreBtn" Style="{StaticResource MenuActionButtonStyle}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Background="{DynamicResource CardSecondaryBrush}"
