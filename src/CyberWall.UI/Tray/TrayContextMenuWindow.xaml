                            </ContentControl>
                            <TextBlock x:Name="WidgetText" Text="Widget flotante" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </CheckBox>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="4,4,4,4" Opacity="0.75"/>

                    <!-- Help (opens Help sub-view matching CyberPaste) -->
                    <Button x:Name="HelpBtn" Style="{StaticResource MenuActionButtonStyle}" HorizontalContentAlignment="Stretch" Click="Help_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ContentControl Style="{StaticResource MenuRowIcon}">
                                    <Viewbox Width="13" Height="13" Stretch="Uniform">
