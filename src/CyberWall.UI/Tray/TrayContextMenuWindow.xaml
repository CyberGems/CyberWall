                    <!-- Statistics -->
                    <Button x:Name="StatsBtn" Style="{StaticResource MenuActionButtonStyle}" Click="Stats_Click">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource MenuRowIcon}">
