                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ContentControl Style="{StaticResource MenuRowIcon}" Width="13" Height="13" Margin="0,0,7,0">
                            <Path Data="M 5 12 H 19 M 13 6 L 19 12 L 13 18" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="12" Height="12" Stretch="Uniform"/>
                        </ContentControl>
                        <TextBlock x:Name="SuiteMoreText" Text="Más detalles en línea..." FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
    </Grid>
</Window>
