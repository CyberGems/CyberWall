                        </StackPanel>
                    </Button>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Viewbox Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Ellipse Canvas.Left="1.5" Canvas.Top="1.5" Width="21" Height="21" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.3" Fill="Transparent"/>
                                <Path Data="M 9.1 9.3 A 3 3 0 0 1 14.9 9.9 C 14.9 11.8 12 12.2 12 14.2" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                <Ellipse Canvas.Left="10.8" Canvas.Top="16.6" Width="2.4" Height="2.4" Fill="{DynamicResource AccentBrush}"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="HelpSubTitleText" Text="Ayuda" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
