<UserControl x:Class="CyberWall.UI.Popup.PromptCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CyberWall.UI.Converters"
             xmlns:ctrl="clr-namespace:CyberWall.UI.Controls"
             TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif"
             Margin="0,0,0,8">
    <UserControl.Resources>
        <conv:PathToIconConverter x:Key="PathToIconConverter"/>

        <Style x:Key="PopupPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                            <Border x:Name="BgBd" Background="{TemplateBinding Background}" CornerRadius="8"/>
                            <Border x:Name="StrokeBd" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="False" IsHitTestVisible="False"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBd" Property="Background" Value="#33EEFF"/>
                                <Setter TargetName="StrokeBd" Property="BorderBrush" Value="#E6FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.85"/>
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PopupBlockButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BadgeBlockFgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                            <Border x:Name="BgBd" Background="{TemplateBinding Background}" CornerRadius="8"/>
                            <Border x:Name="StrokeBd" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="False" IsHitTestVisible="False"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBd" Property="Background" Value="#24EF4444"/>
                                <Setter TargetName="StrokeBd" Property="BorderBrush" Value="{DynamicResource BadgeBlockFgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BgBd" Property="Background" Value="#38EF4444"/>
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PopupDangerButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BadgeBlockFgBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                            <Border x:Name="BgBd" Background="{TemplateBinding Background}" CornerRadius="8"/>
                            <Border x:Name="StrokeBd" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="False" IsHitTestVisible="False"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBd" Property="Background" Value="#FF6680"/>
                                <Setter TargetName="StrokeBd" Property="BorderBrush" Value="#E6FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.85"/>
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PopupSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                            <Border x:Name="BgBd" Background="{TemplateBinding Background}" CornerRadius="8"/>
                            <Border x:Name="StrokeBd" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="False" IsHitTestVisible="False"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBd" Property="Background" Value="{DynamicResource HeaderBgBrush}"/>
                                <Setter TargetName="StrokeBd" Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BgBd" Property="Background" Value="{DynamicResource CardBrush}"/>
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PopupIconButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="{DynamicResource CardSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ToolTipService.Placement" Value="Bottom"/>
            <Setter Property="ToolTipService.VerticalOffset" Value="5"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="350"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="0"/>
            <Setter Property="ToolTipService.ShowDuration" Value="4000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                            <Border x:Name="BgBd" Background="{TemplateBinding Background}" CornerRadius="6"/>
                            <Border x:Name="StrokeBd" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="False" IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBd" Property="Background" Value="{DynamicResource HeaderBgBrush}"/>
                                <Setter TargetName="StrokeBd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BgBd" Property="Background" Value="{DynamicResource SelectionBgBrush}"/>
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.92" ScaleY="0.92"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardDismissButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ToolTipService.Placement" Value="Bottom"/>
            <Setter Property="ToolTipService.VerticalOffset" Value="5"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="350"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="0"/>
            <Setter Property="ToolTipService.ShowDuration" Value="4000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardSecondaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HeaderBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border CornerRadius="12" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Grid Margin="14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Card Header -->
            <Grid x:Name="HeaderBar">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Icon Squircle (No duplicate generic shield) -->
                <Border Width="44" Height="44" CornerRadius="10"
                        Background="{DynamicResource CardSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                        SnapsToDevicePixels="True">
                    <Image Source="{Binding Event.AppPath, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource PathToIconConverter}}"
                           Width="28" Height="28" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Unspecified"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleLbl" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="AppLbl" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0" VerticalAlignment="Center">
                        <Border x:Name="PublisherPill" CornerRadius="6" Padding="7,2" Height="22" VerticalAlignment="Center" Margin="0,0,6,0">
                            <TextBlock x:Name="PublisherLbl" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Border>
                        <Button x:Name="SearchBtn" Style="{StaticResource PopupIconButton}" Click="Search_Click" Margin="0,0,4,0">
                            <Path Fill="{DynamicResource SubTextBrush}" Stretch="Uniform" Width="10" Height="10">
                                <Path.Data>
                                    <GeometryGroup FillRule="EvenOdd">
                                        <PathGeometry Figures="M6,1.2 C3.4,1.2 1.2,3.4 1.2,6 C1.2,8.6 3.4,10.8 6,10.8 C7.1,10.8 8.1,10.4 8.9,9.8 L11.1,12 L12,11.1 L9.8,8.9 C10.4,8.1 10.8,7.1 10.8,6 C10.8,3.4 8.6,1.2 6,1.2 Z"/>
                                        <EllipseGeometry Center="6,6" RadiusX="3.4" RadiusY="3.4"/>
                                    </GeometryGroup>
                                </Path.Data>
                            </Path>
                        </Button>
                        <Button x:Name="CopyPathBtn" Style="{StaticResource PopupIconButton}" Click="CopyPath_Click" Margin="0,0,4,0">
                            <Path Fill="{DynamicResource SubTextBrush}" Stretch="Uniform" Width="10" Height="10"
                                  Data="M4.2,3.4 H9.6 V9.2 H4.2 Z M6.2,1.6 H11.6 V7.4 H10.2 V3 H6.2 Z"/>
                        </Button>
                        <Button x:Name="OpenFolderBtn" Style="{StaticResource PopupIconButton}" Click="OpenFolder_Click">
                            <Path Fill="{DynamicResource SubTextBrush}" Stretch="Uniform" Width="10" Height="10"
                                  Data="M1,3 L1,10 L11,10 L11,5 L6.2,5 L5.2,3 Z"/>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Top Right Card Dismiss Button -->
                <Button Grid.Column="2" x:Name="DismissBtn" Style="{StaticResource CardDismissButton}" VerticalAlignment="Top" Click="Dismiss_Click">
                    <Path Width="9" Height="9" Stretch="Uniform" Data="M 1 1 L 9 9 M 9 1 L 1 9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <!-- Inbound Warning -->
            <Border x:Name="InboundWarn" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource BadgeBlockBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource BadgeBlockFgBrush}" BorderThickness="1" Padding="9,6" Margin="0,8,0,0">
                <TextBlock x:Name="InboundWarnLbl" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BadgeBlockFgBrush}" TextWrapping="Wrap"/>
            </Border>

            <!-- Details Box -->
            <Border Grid.Row="2" Background="{DynamicResource CardSecondaryBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,8" Margin="0,9,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="DirectionPill" CornerRadius="5" Padding="6,1.5" Margin="0,0,7,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="DirectionArrow" Width="9" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0" Fill="Transparent" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 5 11 L 5 1.5 M 5 1.5 L 1.6 5.8 M 5 1.5 L 8.4 5.8"/>
                                <TextBlock x:Name="DirectionPillText" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="DetailLbl" Foreground="{DynamicResource TextBrush}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock x:Name="PathLbl" Foreground="{DynamicResource SubTextBrush}" FontSize="10.5" TextWrapping="NoWrap" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                        <ctrl:CountryFlagMark x:Name="CountryMark" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="CountryLbl" Foreground="{DynamicResource SubTextBrush}" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="MetaLbl" Foreground="{DynamicResource SubTextBrush}" FontSize="10.5" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Footer / Action Buttons -->
            <Grid Grid.Row="3" Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="ScopeLbl" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <TextBlock x:Name="FeedbackLbl" Grid.Row="1" FontSize="10.5" Foreground="{DynamicResource AccentBrush}" Margin="0,3,0,0" Visibility="Collapsed"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button x:Name="BlockBtn" Content="Bloquear" Style="{StaticResource PopupBlockButton}" Click="Block_Click"/>
                    <Button x:Name="AllowOnceBtn" Content="Permitir una vez" Style="{StaticResource PopupSecondaryButton}" Click="AllowOnce_Click" Margin="6,0,0,0"/>
                    <Button x:Name="AllowBtn" Content="Permitir siempre" Style="{StaticResource PopupPrimaryButton}" Click="Allow_Click" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
