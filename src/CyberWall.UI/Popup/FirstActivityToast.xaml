<Window x:Class="CyberWall.UI.Popup.FirstActivityToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:CyberWall.UI.Converters"
        Title="CyberWall — First Network Activity" Height="156" Width="436" WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" Background="Transparent" AllowsTransparency="True" ShowInTaskbar="False" WindowStartupLocation="Manual"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif">
    <Window.Resources>
        <conv:PathToIconConverter x:Key="PathToIconConverter"/>
    </Window.Resources>

    <!-- Outer buffer for clean anti-aliased corners -->
    <Border Margin="8" CornerRadius="14" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Padding="0" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="16" ShadowDepth="4"/>
        </Border.Effect>
        <Grid Margin="14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header: GlassWire style NEW badge + Title + Timestamp + Close -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- GlassWire style circular green NEW badge -->
                <Border Width="26" Height="26" CornerRadius="13" Background="#2E7D32" BorderBrush="#81C784" BorderThickness="1.5" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="NEW" FontSize="8.5" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Title -->
                <TextBlock x:Name="TitleLbl" Grid.Column="1" Text="Primera Actividad de Red" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>

                <!-- Timestamp -->
                <TextBlock x:Name="TimeLbl" Grid.Column="2" Text="Ahora" FontSize="11" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                <!-- Close Button -->
                <Button Grid.Column="3" Content="✕" Width="22" Height="22" Background="Transparent" Foreground="{DynamicResource SubTextBrush}" BorderThickness="0" Cursor="Hand" Click="Close_Click"/>
            </Grid>

            <!-- Body: App Activity Details Card -->
            <Border Grid.Row="1" Background="{DynamicResource CardSecondaryBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,8" Margin="0,10,0,0" VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Icon -->
                    <Image Source="{Binding Event.AppPath, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PathToIconConverter}}" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- Description & Network Endpoint -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="DescLbl" Text="Primera conexión iniciada por el programa." Foreground="{DynamicResource TextBrush}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Border x:Name="DirectionPill" CornerRadius="4" Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                <TextBlock x:Name="DirectionPillText" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="EndpointLbl" Text="TCP • 142.250.190.46:443" Foreground="{DynamicResource SubTextBrush}" FontSize="10.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
