<Window x:Class="CyberWall.UI.Popup.ConnectionPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberWall" Height="210" Width="420" WindowStyle="None" ResizeMode="NoResize" Topmost="True" Background="Transparent" AllowsTransparency="True" ShowInTaskbar="False" WindowStartupLocation="Manual">
    <Border CornerRadius="12" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" Padding="0">
        <Border.Effect><DropShadowEffect Color="Black" Opacity="0.6" BlurRadius="18" ShadowDepth="4"/></Border.Effect>
        <Grid Margin="14">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="8" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1">
                    <TextBlock Text="◉" Foreground="#1F6FEB" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleLbl" Text="Nueva conexión" FontSize="13" FontWeight="Bold" Foreground="#E6EDF3"/>
                    <TextBlock x:Name="AppLbl" Text="demo.exe quiere conectarse" Foreground="#8B949E" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="2" Content="✕" Width="28" Height="28" Background="Transparent" Foreground="#8B949E" BorderThickness="0" Click="Close_Click"/>
            </Grid>
            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                <TextBlock x:Name="DetailLbl" Foreground="#C9D1D9" FontSize="11" TextWrapping="Wrap" Opacity="0.9"/>
                <TextBlock x:Name="PathLbl" Foreground="#484F58" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                <CheckBox x:Name="RememberChk" Content="Recordar mi elección" Foreground="#8B949E" Margin="0,10,0,0" IsChecked="True" FontSize="11"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Bloquear" Width="108" Height="32" Background="#21262D" Foreground="#E6EDF3" BorderBrush="#30363D" BorderThickness="1" Click="Block_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                </Button>
                <Button Content="Permitir" Width="108" Height="32" Margin="8,0,0,0" Background="#1F6FEB" Foreground="White" BorderThickness="0" Click="Allow_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
