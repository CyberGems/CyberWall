<Window x:Class="CyberWall.UI.Popup.ConnectionPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:CyberWall.UI.Converters"
        Title="CyberWall — Network Prompt" Height="220" Width="440" WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" Background="Transparent" AllowsTransparency="True" ShowInTaskbar="False" WindowStartupLocation="Manual"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif">
    <Window.Resources>
        <conv:PathToIconConverter x:Key="PathToIconConverter"/>
    </Window.Resources>
    <Border CornerRadius="14" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1.5" Padding="0">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.65" BlurRadius="22" ShadowDepth="6"/>
        </Border.Effect>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Image Source="{Binding Event.AppPath, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PathToIconConverter}}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <!-- Fallback symbol if icon is null -->
                        <TextBlock Text="🛡️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleLbl" Text="Nueva Solicitud de Conexión" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="AppLbl" Text="demo.exe quiere acceder a la red" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Content="✕" Width="28" Height="28" Background="Transparent" Foreground="{DynamicResource SubTextBrush}" BorderThickness="0" Cursor="Hand" Click="Close_Click"/>
            </Grid>

            <!-- Details -->
            <StackPanel Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Center">
                <Border Background="{DynamicResource CardSecondaryBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,6">
                    <StackPanel>
                        <TextBlock x:Name="DetailLbl" Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="Medium" TextWrapping="Wrap"/>
                        <TextBlock x:Name="PathLbl" Foreground="{DynamicResource SubTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <CheckBox x:Name="RememberChk" Content="Recordar mi elección para siempre" Foreground="{DynamicResource SubTextBrush}" Margin="2,8,0,0" IsChecked="True" FontSize="11" Cursor="Hand"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="BlockBtn" Content="Bloquear" Width="110" Height="34" Background="{DynamicResource CardSecondaryBrush}" Foreground="{DynamicResource BadgeBlockFgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" FontWeight="SemiBold" FontSize="12" Cursor="Hand" Click="Block_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="AllowBtn" Content="Permitir" Width="110" Height="34" Margin="10,0,0,0" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentFgBrush}" BorderThickness="0" FontWeight="Bold" FontSize="12" Cursor="Hand" Click="Allow_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
