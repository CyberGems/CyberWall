<Window x:Class="CyberWall.UI.Popup.AppInfoToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:CyberWall.UI.Converters"
        Title="CyberWall — Notification" Width="450" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" Background="Transparent" AllowsTransparency="True" ShowInTaskbar="False" WindowStartupLocation="Manual"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif">
    <Window.Resources>
        <conv:PathToIconConverter x:Key="PathToIconConverter"/>

        <Style x:Key="ToastIconButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardSecondaryBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HeaderBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Margin="8" CornerRadius="14" Background="{DynamicResource CardBrush}" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="16" ShadowDepth="4"/>
            </Border.Effect>
        </Border>
        <Border Margin="8" CornerRadius="14" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Padding="0" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Grid Margin="14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Header Bar: Badge, Title, Settings & Close -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="BadgeBorder" CornerRadius="6" Background="{DynamicResource BadgeWarnBgBrush}" BorderBrush="{DynamicResource BadgeWarnFgBrush}" BorderThickness="1" Padding="6,2" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock x:Name="BadgeLbl" Text="INFO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BadgeWarnFgBrush}" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TitleLbl" Grid.Column="1" Text="Notificación" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Settings / Config Button next to Close Button -->
                        <Button x:Name="SettingsBtn" Width="22" Height="22" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Settings_Click" Margin="0,0,4,0">
                            <Path Fill="{DynamicResource SubTextBrush}" Width="11" Height="11" Stretch="Uniform"
                                  Data="M 12 15 C 10.3 15 9 13.7 9 12 C 9 10.3 10.3 9 12 9 C 13.7 9 15 10.3 15 12 C 15 13.7 13.7 15 12 15 Z M 19.4 13 C 19.5 12.7 19.5 12.3 19.5 12 C 19.5 11.7 19.5 11.3 19.4 11 L 21.5 9.4 C 21.7 9.2 21.8 8.9 21.6 8.7 L 19.6 5.2 C 19.5 5 19.2 4.9 19 5 L 16.5 6 C 16 5.6 15.4 5.3 14.8 5.1 L 14.4 2.4 C 14.4 2.2 14.2 2 13.9 2 L 10.1 2 C 9.8 2 9.6 2.2 9.6 2.4 L 9.2 5.1 C 8.6 5.3 8 5.6 7.5 6 L 5 5 C 4.8 4.9 4.5 5 4.4 5.2 L 2.4 8.7 C 2.2 8.9 2.3 9.2 2.5 9.4 L 4.6 11 C 4.5 11.3 4.5 11.7 4.5 12 C 4.5 12.3 4.5 12.7 4.6 13 L 2.5 14.6 C 2.3 14.8 2.2 15.1 2.4 15.3 L 4.4 18.8 C 4.5 19 4.8 19.1 5 19 L 7.5 18 C 8 18.4 8.6 18.7 9.2 18.9 L 9.6 21.6 C 9.6 21.8 9.8 22 10.1 22 L 13.9 22 C 14.2 22 14.4 21.8 14.4 21.6 L 14.8 18.9 C 15.4 18.7 16 18.4 16.5 18 L 19 19 C 19.2 19.1 19.5 19 19.6 18.8 L 21.6 15.3 C 21.8 15.1 21.7 14.8 21.5 14.6 L 19.4 13 Z"/>
                        </Button>
                        <Button x:Name="CloseBtn" Content="✕" Width="22" Height="22" Background="Transparent" Foreground="{DynamicResource SubTextBrush}" BorderThickness="0" Cursor="Hand" Click="Close_Click"/>
                    </StackPanel>
                </Grid>

                <!-- 2. Content Card: Icon, Message & Process Information Action Buttons -->
                <Border Grid.Row="1" Background="{DynamicResource CardSecondaryBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12,10" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="28" Height="28" VerticalAlignment="Top" Margin="0,2,10,0">
                            <!-- App Executable Icon -->
                            <Image x:Name="AppIconImg" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                            <!-- WiFi Off Icon -->
                            <Path x:Name="WifiOffIcon" Data="M 12,19 L 12,19.01 M 8.5,15.5 C 10.5,13.8 13.5,13.8 15.5,15.5 M 5.5,12 C 9.2,8.5 14.8,8.5 18.5,12 M 2.5,8.5 C 8,3.5 16,3.5 21.5,8.5 M 3,3 L 21,21" Stroke="{DynamicResource BadgeBlockFgBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="18" Height="18" Fill="Transparent" Visibility="Collapsed"/>
                            <!-- WiFi On Icon -->
                            <Path x:Name="WifiOnIcon" Data="M 12,19 L 12,19.01 M 8.5,15.5 C 10.5,13.8 13.5,13.8 15.5,15.5 M 5.5,12 C 9.2,8.5 14.8,8.5 18.5,12 M 2.5,8.5 C 8,3.5 16,3.5 21.5,8.5" Stroke="{DynamicResource BadgeAllowFgBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="18" Height="18" Fill="Transparent" Visibility="Collapsed"/>
                            <!-- Shield Warn Icon -->
                            <Path x:Name="ShieldWarnIcon" Data="M 12,2 L 4,5 L 4,11 C 4,16.5 7.5,21.3 12,22.5 C 16.5,21.3 20,16.5 20,11 L 20,5 Z M 12,7 L 12,13 M 12,16 L 12,17" Stroke="{DynamicResource BadgeWarnFgBrush}" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="18" Height="18" Fill="Transparent" Visibility="Collapsed"/>
                            <!-- Shield Success Icon -->
                            <Path x:Name="ShieldSuccessIcon" Data="M 12,2 L 4,5 L 4,11 C 4,16.5 7.5,21.3 12,22.5 C 16.5,21.3 20,16.5 20,11 L 20,5 Z M 8.5,12 L 11,14.5 L 15.5,9.5" Stroke="{DynamicResource BadgeAllowFgBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="18" Height="18" Fill="Transparent" Visibility="Collapsed"/>
                            <!-- Info Icon Default -->
                            <Path x:Name="InfoIcon" Data="M 12 2 C 6.48 2 2 6.48 2 12 C 2 17.52 6.48 22 12 22 C 17.52 22 22 17.52 22 12 C 22 6.48 17.52 2 12 2 Z M 12 7 A 1.25 1.25 0 1 1 12 9.5 A 1.25 1.25 0 1 1 12 7 Z M 11 11 L 13 11 L 13 17 L 11 17 Z" Fill="{DynamicResource BadgeWarnFgBrush}" Stretch="Uniform" Width="18" Height="18" Visibility="Collapsed"/>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="DescLbl" Text="Detalle del evento." Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            
                            <!-- Process Actions Panel (Shown when appPath is available) -->
                            <StackPanel x:Name="ProcessActionsPanel" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                                <Button x:Name="SearchBtn" Style="{StaticResource ToastIconButton}" Click="Search_Click" Margin="0,0,5,0">
                                    <Path Fill="{DynamicResource SubTextBrush}" Stretch="Uniform" Width="10" Height="10">
                                        <Path.Data>
                                            <GeometryGroup FillRule="EvenOdd">
                                                <PathGeometry Figures="M6,1.2 C3.4,1.2 1.2,3.4 1.2,6 C1.2,8.6 3.4,10.8 6,10.8 C7.1,10.8 8.1,10.4 8.9,9.8 L11.1,12 L12,11.1 L9.8,8.9 C10.4,8.1 10.8,7.1 10.8,6 C10.8,3.4 8.6,1.2 6,1.2 Z"/>
                                                <EllipseGeometry Center="6,6" RadiusX="3.4" RadiusY="3.4"/>
                                            </GeometryGroup>
                                        </Path.Data>
                                    </Path>
                                </Button>
                                <Button x:Name="CopyPathBtn" Style="{StaticResource ToastIconButton}" Click="CopyPath_Click" Margin="0,0,5,0">
                                    <Path Fill="{DynamicResource SubTextBrush}" Stretch="Uniform" Width="10" Height="10"
                                          Data="M4.2,3.4 H9.6 V9.2 H4.2 Z M6.2,1.6 H11.6 V7.4 H10.2 V3 H6.2 Z"/>
                                </Button>
                                <Button x:Name="OpenFolderBtn" Style="{StaticResource ToastIconButton}" Click="OpenFolder_Click" Margin="0,0,8,0">
                                    <Path Fill="{DynamicResource SubTextBrush}" Stretch="Uniform" Width="10" Height="10"
                                          Data="M1,3 L1,10 L11,10 L11,5 L6.2,5 L5.2,3 Z"/>
                                </Button>
                                <TextBlock x:Name="PathLbl" Text="" Foreground="{DynamicResource SubTextBrush}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
