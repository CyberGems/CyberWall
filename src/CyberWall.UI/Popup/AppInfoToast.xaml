<Window x:Class="CyberWall.UI.Popup.AppInfoToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:CyberWall.UI.Converters"
        Title="CyberWall — Notification" Width="436" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" Background="Transparent" AllowsTransparency="True" ShowInTaskbar="False" WindowStartupLocation="Manual"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif">
    <Window.Resources>
        <conv:PathToIconConverter x:Key="PathToIconConverter"/>
    </Window.Resources>

    <Grid>
        <Border Margin="8" CornerRadius="14" Background="{DynamicResource CardBrush}" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="16" ShadowDepth="4"/>
            </Border.Effect>
        </Border>
        <Border Margin="8" CornerRadius="14" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Padding="0" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Grid Margin="14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="BadgeBorder" CornerRadius="6" Background="{DynamicResource BadgeWarnBgBrush}" BorderBrush="{DynamicResource BadgeWarnFgBrush}" BorderThickness="1" Padding="6,2" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock x:Name="BadgeLbl" Text="INFO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BadgeWarnFgBrush}" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TitleLbl" Grid.Column="1" Text="Notificación" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="CloseBtn" Grid.Column="2" Content="✕" Width="22" Height="22" Background="Transparent" Foreground="{DynamicResource SubTextBrush}" BorderThickness="0" Cursor="Hand" Click="Close_Click"/>
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource CardSecondaryBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,8" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,10,0">
                            <!-- App Executable Icon -->
                            <Image x:Name="AppIconImg" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                            <!-- WiFi Off Icon -->
                            <Path x:Name="WifiOffIcon" Data="M 12,19 L 12,19.01 M 8.5,15.5 C 10.5,13.8 13.5,13.8 15.5,15.5 M 5.5,12 C 9.2,8.5 14.8,8.5 18.5,12 M 2.5,8.5 C 8,3.5 16,3.5 21.5,8.5 M 3,3 L 21,21" Stroke="{DynamicResource BadgeBlockFgBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="18" Height="18" Fill="Transparent" Visibility="Collapsed"/>
                            <!-- WiFi On Icon -->
                            <Path x:Name="WifiOnIcon" Data="M 12,19 L 12,19.01 M 8.5,15.5 C 10.5,13.8 13.5,13.8 15.5,15.5 M 5.5,12 C 9.2,8.5 14.8,8.5 18.5,12 M 2.5,8.5 C 8,3.5 16,3.5 21.5,8.5" Stroke="{DynamicResource BadgeAllowFgBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="18" Height="18" Fill="Transparent" Visibility="Collapsed"/>
                            <!-- Shield Warn Icon -->
                            <Path x:Name="ShieldWarnIcon" Data="M 12,2 L 4,5 L 4,11 C 4,16.5 7.5,21.3 12,22.5 C 16.5,21.3 20,16.5 20,11 L 20,5 Z M 12,7 L 12,13 M 12,16 L 12,17" Stroke="{DynamicResource BadgeWarnFgBrush}" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="18" Height="18" Fill="Transparent" Visibility="Collapsed"/>
                            <!-- Shield Success Icon -->
                            <Path x:Name="ShieldSuccessIcon" Data="M 12,2 L 4,5 L 4,11 C 4,16.5 7.5,21.3 12,22.5 C 16.5,21.3 20,16.5 20,11 L 20,5 Z M 8.5,12 L 11,14.5 L 15.5,9.5" Stroke="{DynamicResource BadgeAllowFgBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="18" Height="18" Fill="Transparent" Visibility="Collapsed"/>
                            <!-- Info Icon Default -->
                            <Path x:Name="InfoIcon" Data="M 12 2 C 6.48 2 2 6.48 2 12 C 2 17.52 6.48 22 12 22 C 17.52 22 22 17.52 22 12 C 22 6.48 17.52 2 12 2 Z M 12 7 A 1.25 1.25 0 1 1 12 9.5 A 1.25 1.25 0 1 1 12 7 Z M 11 11 L 13 11 L 13 17 L 11 17 Z" Fill="{DynamicResource BadgeWarnFgBrush}" Stretch="Uniform" Width="18" Height="18" Visibility="Collapsed"/>
                        </Grid>
                        <TextBlock x:Name="DescLbl" Grid.Column="1" Text="Detalle del evento." Foreground="{DynamicResource TextBrush}" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
