<Window x:Class="CyberWall.UI.Popup.AppInfoToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:CyberWall.UI.Converters"
        Title="CyberWall — Application Info" Width="436" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" Background="Transparent" AllowsTransparency="True" ShowInTaskbar="False" WindowStartupLocation="Manual"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif">
    <Window.Resources>
        <conv:PathToIconConverter x:Key="PathToIconConverter"/>
    </Window.Resources>

    <Grid>
        <Border Margin="8" CornerRadius="14" Background="{DynamicResource CardBrush}" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="16" ShadowDepth="4"/>
            </Border.Effect>
        </Border>
        <Border Margin="8" CornerRadius="14" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Padding="0" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Grid Margin="14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="6" Background="{DynamicResource BadgeWarnBgBrush}" BorderBrush="{DynamicResource BadgeWarnFgBrush}" BorderThickness="1" Padding="6,2" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock x:Name="BadgeLbl" Text="INFO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BadgeWarnFgBrush}" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TitleLbl" Grid.Column="1" Text="Información de la aplicación" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="CloseBtn" Grid.Column="2" Content="✕" Width="22" Height="22" Background="Transparent" Foreground="{DynamicResource SubTextBrush}" BorderThickness="0" Cursor="Hand" Click="Close_Click"/>
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource CardSecondaryBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,8" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image x:Name="AppIconImg" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="DescLbl" Grid.Column="1" Text="La aplicación cambió de versión." Foreground="{DynamicResource TextBrush}" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
