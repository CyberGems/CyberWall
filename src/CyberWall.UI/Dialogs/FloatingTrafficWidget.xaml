<Window x:Class="CyberWall.UI.Dialogs.FloatingTrafficWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:CyberWall.UI.Controls"
        Title="CyberWall"
        Width="330"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <Style x:Key="ModernContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="5" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.5" BlurRadius="16" ShadowDepth="4"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="8,0" SnapsToDevicePixels="True" Margin="0,1">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Icon" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="4,0,16,0"/>
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource SubTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource CardSecondaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernMenuSeparator" TargetType="Separator">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{TemplateBinding Background}" Height="1" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WidgetIconButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WidgetIconToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu x:Name="WidgetMenu" Style="{StaticResource ModernContextMenu}">
            <MenuItem x:Name="WidgetPinItem" Header="Always on top" IsCheckable="True" Style="{StaticResource ModernMenuItem}" Click="WidgetPinItem_Click">
                <MenuItem.Icon>
                    <Path Data="M 9 3 H 15 L 14 9 L 18 12 V 14 H 6 V 12 L 10 9 Z M 12 14 V 21"
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="Transparent"/>
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem x:Name="WidgetShowItem" Header="Show CyberWall" Style="{StaticResource ModernMenuItem}" Click="WidgetShowItem_Click">
                <MenuItem.Icon>
                    <Path Data="M 2 4 H 22 V 18 H 2 Z M 2 8 H 22"
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="Transparent"/>
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem x:Name="WidgetTrafficItem" Header="Traffic Monitor..." Style="{StaticResource ModernMenuItem}" Click="WidgetTrafficItem_Click">
                <MenuItem.Icon>
                    <Path Data="M 2 15 L 6 9 L 10 12 L 15 5 L 20 8 M 15 5 L 20 5 L 20 10"
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="Transparent"/>
                </MenuItem.Icon>
            </MenuItem>

            <Separator Style="{StaticResource ModernMenuSeparator}"/>

            <MenuItem x:Name="WidgetGraphItem" Header="Show live graph" IsCheckable="True" Style="{StaticResource ModernMenuItem}" Click="WidgetGraphItem_Click">
                <MenuItem.Icon>
                    <Path Data="M 3 13 L 7 13 L 7 3 L 3 3 Z M 9 13 L 13 13 L 13 7 L 9 7 Z M 15 13 L 19 13 L 19 10 L 15 10 Z M 2 15 L 20 15"
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="Transparent"/>
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem x:Name="WidgetSessionItem" Header="Show session totals" IsCheckable="True" Style="{StaticResource ModernMenuItem}" Click="WidgetSessionItem_Click">
                <MenuItem.Icon>
                    <Path Data="M 3 20 H 21 M 18 20 V 10 M 12 20 V 4 M 6 20 V 14"
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="Transparent"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.ContextMenu>

    <Border Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Grid Margin="12,9,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: connectivity dot + brand + pin/close -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#4ADE80" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock x:Name="HeaderText" Text="CyberWall" FontSize="11" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ToggleButton x:Name="PinButton" Style="{StaticResource WidgetIconToggle}" Click="PinButton_Click">
                        <Path x:Name="PinIcon"
                              Data="M 9 3 H 15 L 14 9 L 18 12 V 14 H 6 V 12 L 10 9 Z M 12 14 V 21"
                              Stroke="{DynamicResource AccentBrush}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Fill="Transparent"
                              Width="13" Height="13" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ToggleButton>
                    <Button x:Name="CloseButton" Style="{StaticResource WidgetIconButton}" Margin="4,0,0,0" Click="CloseButton_Click">
                        <Path Data="M 6 6 L 18 18 M 18 6 L 6 18"
                              Stroke="{DynamicResource SubTextBrush}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="11" Height="11" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,10"/>

            <!-- Download row -->
            <Grid x:Name="DownRow" Grid.Row="2"
                  ToolTipService.InitialShowDelay="300"
                  ToolTipService.BetweenShowDelay="0"
                  ToolTipService.ShowDuration="20000"
                  ToolTipOpening="DownRow_ToolTipOpening">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 5 1.5 L 5 11 M 5 11 L 1.6 6.7 M 5 11 L 8.4 6.7"
                              Stroke="#00E5FF" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="8" Height="10" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DownLabel" Text="Descarga" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="DownValueText" Text="0.0 B/s" FontSize="15" FontWeight="Bold" Foreground="#00E5FF" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True" Height="38">
                    <ctrl:TrafficGraphControl x:Name="DownGraph"
                                              Height="38"
                                              DownloadColor="#00E5FF"
                                              ShowUpload="False"
                                              ShowGrid="False"
                                              ShowTimeLabels="False"
                                              ShowHoverInspection="False"
                                              ShowScaleLabels="False"
                                              ShowPlotBorder="False"
                                              PlotBackground="Transparent"
                                              CornerRadius="7"/>
                </Border>
            </Grid>

            <Border Grid.Row="3" Height="1" Background="{DynamicResource BorderBrush}" Margin="0,10"/>

            <!-- Upload row -->
            <Grid x:Name="UpRow" Grid.Row="4"
                  ToolTipService.InitialShowDelay="300"
                  ToolTipService.BetweenShowDelay="0"
                  ToolTipService.ShowDuration="20000"
                  ToolTipOpening="UpRow_ToolTipOpening">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 5 11 L 5 1.5 M 5 1.5 L 1.6 5.8 M 5 1.5 L 8.4 5.8"
                              Stroke="#22C55E" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="8" Height="10" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="UpLabel" Text="Subida" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="UpValueText" Text="0.0 B/s" FontSize="15" FontWeight="Bold" Foreground="#22C55E" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True" Height="38">
                    <ctrl:TrafficGraphControl x:Name="UpGraph"
                                              Height="38"
                                              UploadColor="#22C55E"
                                              ShowDownload="False"
                                              ShowGrid="False"
                                              ShowTimeLabels="False"
                                              ShowHoverInspection="False"
                                              ShowScaleLabels="False"
                                              ShowPlotBorder="False"
                                              PlotBackground="Transparent"
                                              CornerRadius="7"/>
                </Border>
            </Grid>

            <!-- Live 60s telemetry graph (same style as the Traffic Monitor chart) -->
            <Border x:Name="GraphSection" Grid.Row="5" Margin="0,10,0,0"
                    Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="10,7,10,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,5"
                          ToolTipService.InitialShowDelay="300"
                          ToolTipService.BetweenShowDelay="0"
                          ToolTipService.ShowDuration="20000"
                          ToolTipOpening="GraphSection_ToolTipOpening">
                        <TextBlock x:Name="GraphTitleText" Text="Telemetría en vivo" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="#00E5FF" Margin="0,0,3,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="GraphLegendDownText" Text="Descarga" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <Ellipse Width="7" Height="7" Fill="#22C55E" Margin="0,0,3,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="GraphLegendUpText" Text="Subida" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <ctrl:TrafficGraphControl x:Name="WidgetTrafficGraph" Grid.Row="1"
                                              Height="62"
                                              MaxSamples="60"
                                              CompactMode="False"
                                              ShowGrid="True"
                                              ShowTimeLabels="False"
                                              ShowScaleLabels="False"
                                              ShowHoverInspection="True"
                                              ShowPlotBorder="False"
                                              PlotBackground="Transparent"
                                              CornerRadius="6"
                                              DownloadColor="#00E5FF"
                                              UploadColor="#22C55E"/>
                </Grid>
            </Border>

            <Border x:Name="SessionDivider" Grid.Row="6" Height="1" Background="{DynamicResource BorderBrush}" Margin="0,10"/>

            <!-- Footer: adapter + session totals -->
            <Grid x:Name="SessionSection" Grid.Row="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M 15 20 L 18 17 H 20 C 21.1 17 22 16.1 22 15 V 6 C 22 4.9 21.1 4 20 4 H 4 C 2.9 4 2 4.9 2 6 V 15 C 2 16.1 2.9 17 4 17 H 6 L 9 20 Z M 6 8 V 10 M 10 8 V 10 M 14 8 V 10 M 18 8 V 10"
                          Stroke="{DynamicResource SubTextBrush}" StrokeThickness="1.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" Fill="Transparent"/>
                    <TextBlock x:Name="AdapterVal" Text="-" FontSize="10" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="↓ " Foreground="#00E5FF" FontWeight="Bold" FontSize="10"/>
                    <TextBlock x:Name="SessionDownVal" Text="0 B" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="↑ " Foreground="#22C55E" FontWeight="Bold" FontSize="10"/>
                    <TextBlock x:Name="SessionUpVal" Text="0 B" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
