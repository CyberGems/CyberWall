<Window x:Class="CyberWall.UI.Dialogs.TrafficHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberWall — Traffic History" Width="760" Height="480"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Primary Action Button Style -->
        <Style x:Key="ModernCloseBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardSecondaryBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title Close Button -->
        <Style x:Key="HeaderCloseBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <Path Data="M 2 2 L 10 10 M 10 2 L 2 10" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C53030"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource HeaderBgBrush}"
            BorderBrush="{DynamicResource BorderLightBrush}"
            BorderThickness="1" CornerRadius="12" Padding="20,16,20,16">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 0: Header -->
                <RowDefinition Height="Auto"/>
                <!-- 1: KPI Stats Cards -->
                <RowDefinition Height="Auto"/>
                <!-- 2: Live 60s Chart -->
                <RowDefinition Height="*"/>
                <!-- 3: Footer Bar -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Header with Title and Close -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                    <!-- Activity Wave Icon -->
                    <Path Data="M 2 11 L 6 11 L 9 4 L 13 18 L 17 8 L 20 14 L 22 11 L 26 11" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="20" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="DialogTitleText" Text="Historial de Tráfico de Red" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="DialogSubtitleText" Text="Telemetría en tiempo real de los últimos 60 segundos" FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource HeaderCloseBtnStyle}" Click="Close_Click" VerticalAlignment="Top"/>
            </Grid>

            <!-- Row 1: KPI Stats Cards -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Download KPI Card -->
                <Border Grid.Column="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="20" Height="20" CornerRadius="10" Background="#172A45" Margin="0,0,8,0">
                                    <Path Data="M 5 1.5 L 5 11 M 5 11 L 1.6 6.7 M 5 11 L 8.4 6.7" Stroke="#38BDF8" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="8" Height="9" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="DownTitleLbl" Text="Descarga" FontWeight="SemiBold" FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="DownCurrentSpeedVal" Text="0.0 B/s" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                        </Grid>

                        <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.5" Margin="0,4,0,6"/>

                        <!-- Metrics Row -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="DownPeakLbl" Text="Pico (60s)" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}"/>
                                <TextBlock x:Name="DownPeakVal" Text="0.0 B/s" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,1,0,0" Typography.NumeralAlignment="Tabular"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="DownAvgLbl" Text="Promedio" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}"/>
                                <TextBlock x:Name="DownAvgVal" Text="0.0 B/s" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,1,0,0" Typography.NumeralAlignment="Tabular"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="DownTotalLbl" Text="Sesión" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}"/>
                                <TextBlock x:Name="DownTotalVal" Text="0 MB" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,1,0,0" Typography.NumeralAlignment="Tabular"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Upload KPI Card -->
                <Border Grid.Column="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="20" Height="20" CornerRadius="10" Background="#133324" Margin="0,0,8,0">
                                    <Path Data="M 5 11 L 5 1.5 M 5 1.5 L 1.6 5.8 M 5 1.5 L 8.4 5.8" Stroke="#22C55E" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="8" Height="9" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="UpTitleLbl" Text="Subida" FontWeight="SemiBold" FontSize="12" Foreground="#22C55E" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="UpCurrentSpeedVal" Text="0.0 B/s" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                        </Grid>

                        <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.5" Margin="0,4,0,6"/>

                        <!-- Metrics Row -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="UpPeakLbl" Text="Pico (60s)" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}"/>
                                <TextBlock x:Name="UpPeakVal" Text="0.0 B/s" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,1,0,0" Typography.NumeralAlignment="Tabular"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="UpAvgLbl" Text="Promedio" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}"/>
                                <TextBlock x:Name="UpAvgVal" Text="0.0 B/s" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,1,0,0" Typography.NumeralAlignment="Tabular"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="UpTotalLbl" Text="Sesión" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}"/>
                                <TextBlock x:Name="UpTotalVal" Text="0 MB" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,1,0,0" Typography.NumeralAlignment="Tabular"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Row 2: Live 60s Dual-Line Chart -->
            <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12,14,8" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Top Legend & Peak Indicator -->
                        <RowDefinition Height="Auto"/>
                        <!-- Chart Surface Canvas -->
                        <RowDefinition Height="*"/>
                        <!-- Time Axis Labels -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Legend -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock x:Name="ChartPeakRateText" Text="Escala máxima: 0 B/s" FontSize="10" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- Download Legend -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                                <Rectangle Width="14" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LegendDownText" Text="Descarga" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Upload Legend -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Rectangle Width="14" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#22C55E" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LegendUpText" Text="Subida" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Chart Surface -->
                    <Grid Grid.Row="1" x:Name="ChartContainer" ClipToBounds="True" SizeChanged="ChartContainer_SizeChanged">
                        <!-- Horizontal Grid Lines -->
                        <Grid VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Opacity="0.3"/>
                            <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Opacity="0.3"/>
                            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Opacity="0.3"/>
                            <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" Opacity="0.4"/>
                        </Grid>

                        <!-- Canvas for Drawing Wave Paths -->
                        <Canvas x:Name="ChartCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <!-- Download Area & Line -->
                            <Path x:Name="DownloadAreaPath">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#4038BDF8" Offset="0.0"/>
                                        <GradientStop Color="#0038BDF8" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>
                            <Path x:Name="DownloadLinePath" Stroke="#38BDF8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>

                            <!-- Upload Area & Line -->
                            <Path x:Name="UploadAreaPath">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#3022C55E" Offset="0.0"/>
                                        <GradientStop Color="#0022C55E" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>
                            <Path x:Name="UploadLinePath" Stroke="#22C55E" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Grid>

                    <!-- Time Axis Labels -->
                    <Grid Grid.Row="2" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="-60s" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="1" Text="-45s" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="-30s" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="-15s" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="4" x:Name="TimeNowLbl" Text="Ahora" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Row 3: Footer with Adapter Info & Close Button -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Active Adapter Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M 12 2 L 2 6 L 2 13 C 2 19 6.5 24.5 12 26 C 17.5 24.5 22 19 22 13 L 22 6 Z" Width="11" Height="13" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AdapterHeaderLbl" Text="Adaptador:" FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AdapterValueLbl" Text="Wi-Fi / Ethernet" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="1" Style="{StaticResource ModernCloseBtnStyle}" Width="100" Height="32" Click="Close_Click">
                    <TextBlock x:Name="CloseBtnText" Text="Cerrar" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
