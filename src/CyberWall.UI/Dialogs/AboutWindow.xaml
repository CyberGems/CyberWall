<Window x:Class="CyberWall.UI.Dialogs.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About ᐧ CyberWall"
        Height="570" Width="720"
        MinHeight="480" MinWidth="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif">

    <Window.Resources>
        <Style x:Key="AboutFooterIconButton" TargetType="Border">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardSecondaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Custom Title Close Button -->
        <Style x:Key="TitleCloseButton" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Action Button -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource CardSecondaryBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource HeaderBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox Switch Style -->
        <Style x:Key="ModernToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border x:Name="Track" Width="40" Height="22" CornerRadius="11" Background="{DynamicResource SwitchTrackBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.2"/>
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="#CBD5E1" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="Black" Opacity="0.25" BlurRadius="3" ShadowDepth="1"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Custom Window Frame with Smooth Anti-Aliasing Buffer Margin -->
    <Border Margin="5" CornerRadius="12">
        <Border x:Name="OuterBorder" CornerRadius="12" ClipToBounds="True" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource BgBrush}" SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Custom Title Bar -->
                <Border Grid.Row="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0" Padding="18,10" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 12 2 C 6.48 2 2 6.48 2 12 C 2 17.52 6.48 22 12 22 C 17.52 22 22 17.52 22 12 C 22 6.48 17.52 2 12 2 Z M 11 7 L 13 7 L 13 9 L 11 9 Z M 11 11 L 13 11 L 13 17 L 11 17 Z" Fill="{DynamicResource AccentBrush}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="AboutTitleText" Text="Acerca de ᐧ CyberWall" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="✕" Style="{StaticResource TitleCloseButton}" HorizontalAlignment="Right" Click="Close_Click"/>
                    </Grid>
                </Border>

                <!-- Body Content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,18,24,18">
                    <StackPanel>
                        <!-- Hero Section: Branding + Description -->
                        <Grid Margin="0,4,0,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" MinWidth="220"/>
                            </Grid.ColumnDefinitions>

                            <!-- Brand Name + Version -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/Assets/CyberWall.png" Width="52" Height="52" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="28" FontWeight="Bold" FontFamily="Segoe UI Variable Display">
                                        <Run Text="Cyber" Foreground="{DynamicResource TextBrush}"/><Run Text="Wall" Foreground="{DynamicResource AccentBrush}"/>
                                    </TextBlock>
                                    <TextBlock x:Name="AboutVersionText" Text="Version v1.5.0" FontSize="13" Foreground="{DynamicResource SubTextBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Description Box -->
                            <Border Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="28,0,0,0">
                                <TextBlock x:Name="AboutDescriptionText" FontSize="12.5" Foreground="{DynamicResource TextBrush}" Opacity="0.85" LineHeight="22" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" Text="CyberWall es un firewall de capa de aplicación ultrarrápido impulsado por el motor del kernel Windows Filtering Platform (WFP) para filtrado de red por programa en tiempo real."/>
                            </Border>
                        </Grid>

                        <!-- Updates & Maintenance Card -->
                        <TextBlock x:Name="UpdatesSectionLbl" Text="Actualizaciones y Mantenimiento" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="13.5" Margin="0,0,0,8"/>
                        <Border CornerRadius="12" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18,12" Margin="0,0,0,10">
                            <StackPanel>
                                <!-- Row 1: Auto-check toggle -->
                                <Grid MinHeight="48">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon -->
                                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Path Data="M 4 4 V 9 H 9 M 20 20 V 15 H 15 M 20 9 A 9 9 0 0 0 5.64 5.64 L 4 9 M 4 15 A 9 9 0 0 0 18.36 18.36 L 20 15" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="Transparent"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock x:Name="AutoUpdateTitleLbl" Text="Buscar actualizaciones al iniciar" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock x:Name="AutoUpdateDescLbl" Text="Comprobar automáticamente si hay nuevas versiones al iniciar CyberWall." FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <CheckBox x:Name="AutoCheckUpdateCheck" Grid.Column="2" Style="{StaticResource ModernToggleSwitch}" VerticalAlignment="Center" Checked="AutoCheckUpdateCheck_Changed" Unchecked="AutoCheckUpdateCheck_Changed"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,8,0,8"/>

                                <!-- Row 2: Check for updates button -->
                                <Grid MinHeight="48">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon -->
                                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Path Data="M 12 2 A 10 10 0 1 0 22 12 A 10 10 0 0 0 12 2 Z M 2 12 H 22 M 12 2 A 15.3 15.3 0 0 1 16 12 A 15.3 15.3 0 0 1 12 22 A 15.3 15.3 0 0 1 8 12 A 15.3 15.3 0 0 1 12 2 Z" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3" Fill="Transparent" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock x:Name="CheckUpdateTitleLbl" Text="Buscar actualizaciones" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock x:Name="CheckUpdateDescLbl" Text="Comprobar la versión más reciente y descargar actualizaciones directamente." FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Button x:Name="UpdateBtn" Grid.Column="2" Content="Comprobar ahora" Style="{StaticResource ModernButton}" VerticalAlignment="Center" MinWidth="130" Height="34" Click="UpdateCheckButton_Click"/>
                                </Grid>

                                <!-- Download Progress Panel -->
                                <StackPanel x:Name="UpdateProgressPanel" Visibility="Collapsed" Margin="42,10,0,6">
                                    <TextBlock x:Name="UpdateProgressText" Text="Descargando actualización..." FontSize="11.5" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                                    <ProgressBar x:Name="UpdateProgressBar" Height="6" Minimum="0" Maximum="100" Value="0" Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Section: CyberGems Branding + External Links -->
                <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,11,11" Padding="20,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Copyright -->
                        <TextBlock x:Name="AboutFooterCopyright" Grid.Column="0" Text="© CyberGems • 2026" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Cursor="Hand" ToolTip="Visitar sitio web de CyberGems" MouseLeftButtonUp="AboutFooterWebsite_Click"/>

                        <!-- Action Icons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Website -->
                            <Border x:Name="AboutFooterWebsiteBtn" Style="{StaticResource AboutFooterIconButton}" ToolTip="Visitar sitio web de CyberGems" MouseLeftButtonUp="AboutFooterWebsite_Click">
                                <Viewbox Width="15" Height="15" Stretch="Uniform">
                                    <Canvas Width="20" Height="20">
                                        <Path Stroke="{DynamicResource SubTextBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" Fill="Transparent" Data="M4.5 7.5V15.5A1.5 1.5 0 0 0 6 17h8.5A1.5 1.5 0 0 0 16 15.5V12"/>
                                        <Path Stroke="{DynamicResource SubTextBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Data="M10.5 3.5H16.5V9.5M16.2 3.8L9 11"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>

                            <!-- GitHub Repo -->
                            <Border x:Name="AboutFooterGithubBtn" Style="{StaticResource AboutFooterIconButton}" ToolTip="Ver proyecto en GitHub" MouseLeftButtonUp="AboutFooterGithub_Click" Margin="4,0,0,0">
                                <Viewbox Width="15" Height="15" Stretch="Uniform">
                                    <Path Fill="{DynamicResource SubTextBrush}" Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
                                </Viewbox>
                            </Border>

                            <!-- Issues -->
                            <Border x:Name="AboutFooterIssuesBtn" Style="{StaticResource AboutFooterIconButton}" ToolTip="Reportar un error o sugerencia" MouseLeftButtonUp="AboutFooterIssues_Click" Margin="4,0,0,0">
                                <Viewbox Width="15" Height="15" Stretch="Uniform">
                                    <Canvas Width="24" Height="24">
                                        <Ellipse Width="18" Height="18" Canvas.Left="3" Canvas.Top="3" Stroke="{DynamicResource SubTextBrush}" StrokeThickness="2" Fill="Transparent"/>
                                        <Ellipse Width="4" Height="4" Canvas.Left="10" Canvas.Top="10" Fill="{DynamicResource SubTextBrush}"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>

                            <!-- Releases -->
                            <Border x:Name="AboutFooterReleasesBtn" Style="{StaticResource AboutFooterIconButton}" ToolTip="Ver versiones y notas de cambios" MouseLeftButtonUp="AboutFooterReleases_Click" Margin="4,0,0,0">
                                <Viewbox Width="15" Height="15" Stretch="Uniform">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="{DynamicResource SubTextBrush}" StrokeThickness="2" StrokeLineJoin="Round" Fill="Transparent" Data="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.41 2.41 0 0 0 3.408 0l5.586-5.586a2.41 2.41 0 0 0 0-3.408z"/>
                                        <Ellipse Width="2.5" Height="2.5" Canvas.Left="6" Canvas.Top="6.5" Fill="{DynamicResource SubTextBrush}"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
