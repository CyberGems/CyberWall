<Window x:Class="CyberWall.UI.Dialogs.UpdateNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual" Background="Transparent" SizeToContent="Height" Width="480"
        Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <Style x:Key="NoticeButton" TargetType="Button">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SelectionBgBrush}"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NoticePrimaryButton" TargetType="Button" BasedOn="{StaticResource NoticeButton}">
            <Setter Property="Background" Value="{DynamicResource SelectionBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    <Border CornerRadius="12" Background="{DynamicResource CardSecondaryBrush}"
            BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" Margin="0,0,10,0" CornerRadius="8" VerticalAlignment="Top"
                            Background="{DynamicResource AccentGlowBrush}">
                        <Image Source="/CyberWall;component/Assets/CyberWall.png" Width="26" Height="26"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StageTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock x:Name="VersionLabel" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SubTextBrush}"/>
                    </StackPanel>
                    <Button x:Name="DismissButton" Grid.Column="2" Width="32" Padding="0" VerticalAlignment="Top"
                            Style="{StaticResource NoticeButton}" Click="Dismiss_Click">
                        <Path Data="M 2 2 L 10 10 M 2 10 L 10 2" Stroke="{DynamicResource SubTextBrush}"
                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </Grid>

                <Border Margin="0,0,0,10" Padding="10,8" CornerRadius="7" BorderThickness="1"
                        Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}">
                    <StackPanel>
                        <TextBlock x:Name="NotesTitle" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <ItemsControl x:Name="NotesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="•" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{DynamicResource SubTextBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NotesUnavailable" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SubTextBrush}"/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="DownloadPanel" Margin="0,0,0,10">
                    <TextBlock x:Name="ProgressText" FontSize="12" Margin="0,0,0,4" TextWrapping="Wrap" Foreground="{DynamicResource SubTextBrush}"/>
                    <ProgressBar x:Name="DownloadProgressBar" Height="6" Maximum="100" BorderThickness="0"
                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BgBrush}"/>
                </StackPanel>
                <TextBlock x:Name="ErrorText" Margin="0,0,0,8" FontSize="12" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"/>

                <WrapPanel HorizontalAlignment="Right">
                    <Button x:Name="GitHubButton" Margin="0,4,6,0" Style="{StaticResource NoticeButton}" Click="GitHub_Click"/>
                    <Button x:Name="SkipButton" Margin="0,4,6,0" Style="{StaticResource NoticeButton}" Click="Skip_Click"/>
                    <Button x:Name="LaterButton" Margin="0,4,6,0" Style="{StaticResource NoticeButton}" Click="Dismiss_Click"/>
                    <Button x:Name="CancelButton" Margin="0,4,0,0" Style="{StaticResource NoticeButton}" Click="Cancel_Click"/>
                    <Button x:Name="PrimaryButton" Margin="0,4,0,0" Style="{StaticResource NoticePrimaryButton}" Click="Primary_Click"/>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
