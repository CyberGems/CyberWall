<Window x:Class="CyberWall.UI.Dialogs.StatisticsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:CyberWall.UI.Converters"
        xmlns:ctrl="clr-namespace:CyberWall.UI.Controls"
        Title="CyberWall — Statistics" Height="620" Width="890" MinHeight="520" MinWidth="750"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif">

    <Window.Resources>
        <conv:PathToIconConverter x:Key="PathToIconConverter"/>

        <!-- Themed Modern ScrollBar Styles -->
        <Style x:Key="CustomScrollThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Opacity" Value="0.4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border CornerRadius="3" Background="{DynamicResource SubTextBrush}" Margin="1,2,2,2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CustomScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent" Width="{TemplateBinding Width}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,4,0,4">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Background="Transparent" BorderThickness="0" Focusable="False" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource CustomScrollThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Background="Transparent" BorderThickness="0" Focusable="False" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource CustomScrollBarStyle}"/>

        <!-- Window Buttons -->
        <Style x:Key="TitleCloseButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Unified Primary Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Unified Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HeaderBgBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark Themed ComboBox Style -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="TemplateRoot" Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource SubTextBrush}" Data="M 0 0 L 3.5 3.5 L 7 0 Z"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="StatsComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" Template="{StaticResource ComboBoxToggleButton}" Grid.Column="2" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,3,24,3" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Margin="0,4,0,4">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="12" ShadowDepth="4"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource HeaderBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Custom Modal Window Container -->
    <Border CornerRadius="12" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" SnapsToDevicePixels="True">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Title Bar & Period Filter Toolbar -->
            <Border Grid.Row="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0" Padding="18,12" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Icon, Title, Badge -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                            <Path Data="M 3 13 L 7 13 L 7 3 L 3 3 Z M 9 13 L 13 13 L 13 7 L 9 7 Z M 15 13 L 19 13 L 19 10 L 15 10 Z M 2 15 L 20 15" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" Width="13" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TitleLbl" Text="Estadísticas de Tráfico y Seguridad" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="CountBadge" Text="0 eventos" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                    </StackPanel>

                    <!-- Right: Period Selector, Refresh & Close Button -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="PeriodLabel" Text="Período:" Foreground="{DynamicResource SubTextBrush}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="PeriodCombo" Style="{StaticResource StatsComboBox}" Width="145" Height="30" Margin="0,0,10,0" SelectionChanged="PeriodCombo_SelectionChanged"/>

                        <Button x:Name="RefreshBtn" Style="{StaticResource SecondaryButtonStyle}" Height="30" Padding="9,4" Margin="0,0,12,0" Click="Refresh_Click" ToolTip="Actualizar datos">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 4 4 V 9 H 9 M 20 20 V 15 H 15 M 20 9 A 9 9 0 0 0 5.64 5.64 L 4 9 M 4 15 A 9 9 0 0 0 18.36 18.36 L 20 15" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" Fill="Transparent"/>
                                <TextBlock x:Name="RefreshBtnText" Text="Actualizar" VerticalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                        </Button>

                        <Button Content="✕" Style="{StaticResource TitleCloseButton}" HorizontalAlignment="Right" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Main Content Scrollable Area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,14">
                <Grid>
                    <!-- Statistics Dashboard View -->
                    <StackPanel x:Name="DashboardView">
                        <!-- Top Row: 4 KPI Cards -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: Total Events -->
                            <Border Grid.Column="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Path Data="M 12 2 L 4 5 L 4 11 C 4 16.5 7.4 21.6 12 23 C 16.6 21.6 20 16.5 20 11 L 20 5 Z" Stroke="{DynamicResource SubTextBrush}" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" Fill="Transparent"/>
                                        <TextBlock x:Name="CardTotalTitle" Text="Total Eventos" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TotalEventsVal" Text="0" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="CardTotalDesc" Text="Eventos procesados" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Blocked Events -->
                            <Border Grid.Column="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Path Data="M 12 2 A 10 10 0 1 0 12 22 A 10 10 0 1 0 12 2 Z M 4.93 4.93 L 19.07 19.07" Stroke="#FF4D6D" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" Fill="Transparent"/>
                                        <TextBlock x:Name="CardBlockedTitle" Text="Bloqueados" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock x:Name="BlockedEventsVal" Text="0" FontSize="20" FontWeight="Bold" Foreground="#FF4D6D"/>
                                        <TextBlock x:Name="BlockedPctVal" Text=" (0%)" FontSize="12.5" FontWeight="SemiBold" Foreground="#FF4D6D" VerticalAlignment="Bottom" Margin="2,0,0,3"/>
                                    </StackPanel>
                                    <TextBlock x:Name="CardBlockedDesc" Text="Amenazas y reglas" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Allowed Events -->
                            <Border Grid.Column="4" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Path Data="M 12 2 A 10 10 0 1 0 12 22 A 10 10 0 1 0 12 2 Z M 7.5 12 L 10.5 15 L 16.5 9" Stroke="#00F5A0" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" Fill="Transparent"/>
                                        <TextBlock x:Name="CardAllowedTitle" Text="Permitidos" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock x:Name="AllowedEventsVal" Text="0" FontSize="20" FontWeight="Bold" Foreground="#00F5A0"/>
                                        <TextBlock x:Name="AllowedPctVal" Text=" (0%)" FontSize="12.5" FontWeight="SemiBold" Foreground="#00F5A0" VerticalAlignment="Bottom" Margin="2,0,0,3"/>
                                    </StackPanel>
                                    <TextBlock x:Name="CardAllowedDesc" Text="Tráfico permitido" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 4: Global Scope (Countries & Apps) -->
                            <Border Grid.Column="6" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Path Data="M 12 2 A 10 10 0 1 0 12 22 A 10 10 0 1 0 12 2 Z M 2 12 H 22 M 12 2 C 15 5.5 16.5 8.5 16.5 12 C 16.5 15.5 15 18.5 12 22 C 9 18.5 7.5 15.5 7.5 12 C 7.5 8.5 9 5.5 12 2 Z" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.2" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" Fill="Transparent"/>
                                        <TextBlock x:Name="CardScopeTitle" Text="Alcance Global" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ScopeVal" Text="0 países" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,2" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="CardScopeDesc" Text="0 apps registradas" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Middle Section: 2 Columns of Visual Distribution Cards -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- LEFT COLUMN: Top Apps & Traffic Direction -->
                            <StackPanel Grid.Column="0">
                                <!-- Card: Top Applications -->
                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14,12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M 12 2 L 2 7 L 12 12 L 22 7 Z M 2 17 L 12 22 L 22 17 M 2 12 L 12 17 L 22 12" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" Fill="Transparent"/>
                                                <TextBlock x:Name="TopAppsTitle" Text="Aplicaciones más Activas" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="Top 5" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Top Apps Items List -->
                                        <ItemsControl x:Name="TopAppsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3,0,5">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Row 1: Icon, Name, Count & % -->
                                                        <Grid Grid.Row="0" Margin="0,0,0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Image Grid.Column="0" Source="{Binding IconPath, Converter={StaticResource PathToIconConverter}}" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding IconPath}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding CountFormatted}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                                                                <TextBlock Text=" ev." FontSize="10" Foreground="{DynamicResource SubTextBrush}"/>
                                                                <TextBlock Text=" (" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}"/>
                                                                <TextBlock Text="{Binding PercentageFormatted}" FontWeight="SemiBold" FontSize="10.5" Foreground="{DynamicResource AccentBrush}"/>
                                                                <TextBlock Text=")" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Row 2: Proportion Bar -->
                                                        <Border Grid.Row="1" Height="6" CornerRadius="3" Background="{DynamicResource CardSecondaryBrush}">
                                                            <ProgressBar Value="{Binding Percentage}" Maximum="100" Height="6" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource AccentBrush}"/>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Card: Traffic Direction -->
                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M 4 8 H 18 M 14 4 L 18 8 L 14 12 M 20 16 H 6 M 10 12 L 6 16 L 10 20" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" Fill="Transparent"/>
                                                <TextBlock x:Name="TrafficDirTitle" Text="Flujo de Tráfico" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Outbound & Inbound stats -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Outbound -->
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="8" Height="8" CornerRadius="2" Background="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="OutboundLbl" Text="Saliente (Outbound)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                                </StackPanel>
                                                <TextBlock x:Name="OutboundVal" Text="0 (0%)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="14,2,0,0"/>
                                            </StackPanel>

                                            <!-- Inbound -->
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="8" Height="8" CornerRadius="2" Background="#A78BFA" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="InboundLbl" Text="Entrante (Inbound)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                                </StackPanel>
                                                <TextBlock x:Name="InboundVal" Text="0 (0%)" FontSize="12" FontWeight="Bold" Foreground="#A78BFA" Margin="14,2,0,0" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Dual Segmented Progress Bar -->
                                        <Border Height="8" CornerRadius="4" Background="{DynamicResource CardSecondaryBrush}" ClipToBounds="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition x:Name="OutboundBarCol" Width="50*"/>
                                                    <ColumnDefinition x:Name="InboundBarCol" Width="50*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{DynamicResource AccentBrush}"/>
                                                <Border Grid.Column="1" Background="#A78BFA"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- RIGHT COLUMN: Top Countries & Top Ports -->
                            <StackPanel Grid.Column="2">
                                <!-- Card: Top Countries -->
                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14,12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M 12 2 A 10 10 0 1 0 12 22 A 10 10 0 1 0 12 2 Z M 2 12 H 22 M 12 2 C 15 5.5 16.5 8.5 16.5 12 C 16.5 15.5 15 18.5 12 22 C 9 18.5 7.5 15.5 7.5 12 C 7.5 8.5 9 5.5 12 2 Z" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.2" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" Fill="Transparent"/>
                                                <TextBlock x:Name="TopCountriesTitle" Text="Países de Destino" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="Top 5" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Top Countries Items List -->
                                        <ItemsControl x:Name="TopCountriesList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3,0,5">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Row 1: Flag, Country Name, Count & % -->
                                                        <Grid Grid.Row="0" Margin="0,0,0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <ctrl:CountryFlagMark Grid.Column="0" CountryCode="{Binding CountryCode}" HasCountry="{Binding HasCountry}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding CountryLabel}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding CountFormatted}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                                                                <TextBlock Text=" (" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}"/>
                                                                <TextBlock Text="{Binding PercentageFormatted}" FontWeight="SemiBold" FontSize="10.5" Foreground="#00F5A0"/>
                                                                <TextBlock Text=")" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Row 2: Proportion Bar -->
                                                        <Border Grid.Row="1" Height="6" CornerRadius="3" Background="{DynamicResource CardSecondaryBrush}">
                                                            <ProgressBar Value="{Binding Percentage}" Maximum="100" Height="6" BorderThickness="0" Background="Transparent" Foreground="#00F5A0"/>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Card: Top Ports & Protocols -->
                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M 12 2 V 6 M 7 2 V 6 M 5 6 H 14 V 11 C 14 13.5 12 15 9.5 15 C 7 15 5 13.5 5 11 Z M 9.5 15 V 22" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" Fill="Transparent"/>
                                                <TextBlock x:Name="TopPortsTitle" Text="Puertos más Utilizados" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="Top 5" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Top Ports Items List -->
                                        <ItemsControl x:Name="TopPortsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3,0,5">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Row 1: Port label, Count & % -->
                                                        <Grid Grid.Row="0" Margin="0,0,0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0" Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontFamily="Consolas, Segoe UI" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                                            </Border>

                                                            <TextBlock Grid.Column="1" Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding CountFormatted}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                                                                <TextBlock Text=" (" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}"/>
                                                                <TextBlock Text="{Binding PercentageFormatted}" FontWeight="SemiBold" FontSize="10.5" Foreground="#F59E0B"/>
                                                                <TextBlock Text=")" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Row 2: Proportion Bar -->
                                                        <Border Grid.Row="1" Height="6" CornerRadius="3" Background="{DynamicResource CardSecondaryBrush}">
                                                            <ProgressBar Value="{Binding Percentage}" Maximum="100" Height="6" BorderThickness="0" Background="Transparent" Foreground="#F59E0B"/>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Empty State (Shown if 0 events) -->
                    <Border x:Name="EmptyStateView" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="24,40" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" MinWidth="420">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <Path Data="M 3 13 L 7 13 L 7 3 L 3 3 Z M 9 13 L 13 13 L 13 7 L 9 7 Z M 15 13 L 19 13 L 19 10 L 15 10 Z M 2 15 L 20 15" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="EmptyMsgTitle" Text="Sin registros de tráfico" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock x:Name="EmptyMsgDesc" Text="No hay eventos de red registrados para el período seleccionado." FontSize="11.5" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- 3. Footer Bar -->
            <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,11,11" Padding="18,11">
                <Grid>
                    <!-- Left Actions -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ViewLogBtn" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="ViewLog_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 4 2 L 14 2 L 18 6 L 18 20 L 4 20 Z M 13 2 L 13 7 L 18 7 M 7 11 L 15 11 M 7 14 L 15 14 M 7 17 L 12 17" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.2" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ViewLogBtnText" Text="Ver registro completo..." VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="CopySummaryBtn" Style="{StaticResource SecondaryButtonStyle}" Click="CopySummary_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 16 1 H 4 C 2.9 1 2 1.9 2 3 V 17 H 4 V 3 H 16 V 1 Z M 19 5 H 8 C 6.9 5 6 5.9 6 7 V 21 C 6 22.1 6.9 23 8 23 H 19 C 20.1 23 21 22.1 21 21 V 7 C 21 5.9 20.1 5 19 5 Z" Fill="{DynamicResource SubTextBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CopySummaryBtnText" Text="Copiar resumen" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Right Action: Close -->
                    <Button x:Name="CloseBtn" Content="Cerrar" Width="95" Height="32" HorizontalAlignment="Right" Style="{StaticResource PrimaryButtonStyle}" Click="Close_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
