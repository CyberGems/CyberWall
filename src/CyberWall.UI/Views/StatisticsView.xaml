<UserControl x:Class="CyberWall.UI.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CyberWall.UI.Converters"
             xmlns:ctrl="clr-namespace:CyberWall.UI.Controls"
             TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif">

    <UserControl.Resources>
        <conv:PathToIconConverter x:Key="PathToIconConverter"/>

        <!-- Action Button Style -->
        <Style x:Key="StatsToolbarBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HeaderBgBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter Radio Pill Style -->
        <Style x:Key="StatsFilterRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="12,4" Margin="2,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardSecondaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stats ComboBox Style -->
        <ControlTemplate x:Key="StatsComboToggle" TargetType="ToggleButton">
            <Border x:Name="TemplateRoot" Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource SubTextBrush}" Data="M 0 0 L 3.5 3.5 L 7 0 Z"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="StatsComboStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" Template="{StaticResource StatsComboToggle}" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,2,24,2" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="220">
                                    <Border x:Name="DropDownBorder" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Margin="0,4,0,4">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="10" ShadowDepth="3"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="4,5" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource HeaderBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Main Container Card -->
    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16,14">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 0: Toolbar -->
                <RowDefinition Height="Auto"/>
                <!-- 1: Dashboard Scrollable Content -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Toolbar -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Verdict Filter [ Todos | Bloqueados | Permitidos ] -->
                <Border Grid.Column="0" VerticalAlignment="Center" Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="FilterAllRadio" GroupName="StatFilter" Content="Todos" Style="{StaticResource StatsFilterRadioStyle}" IsChecked="True" Checked="FilterRadio_Checked"/>
                        <RadioButton x:Name="FilterBlockedRadio" GroupName="StatFilter" Content="Bloqueados" Style="{StaticResource StatsFilterRadioStyle}" Checked="FilterRadio_Checked"/>
                        <RadioButton x:Name="FilterAllowedRadio" GroupName="StatFilter" Content="Permitidos" Style="{StaticResource StatsFilterRadioStyle}" Checked="FilterRadio_Checked"/>
                    </StackPanel>
                </Border>

                <!-- Center: Period Selector -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock x:Name="PeriodLabel" Text="Período:" Foreground="{DynamicResource SubTextBrush}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="PeriodCombo" Style="{StaticResource StatsComboStyle}" Width="145" Height="30" SelectionChanged="PeriodCombo_SelectionChanged"/>
                </StackPanel>

                <!-- Right: Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RefreshBtn" Style="{StaticResource StatsToolbarBtnStyle}" Height="30" Padding="10,4" Margin="0,0,8,0" Click="Refresh_Click" ToolTip="Actualizar datos">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 4 4 V 9 H 9 M 20 20 V 15 H 15 M 20 9 A 9 9 0 0 0 5.64 5.64 L 4 9 M 4 15 A 9 9 0 0 0 18.36 18.36 L 20 15" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" Fill="Transparent"/>
                            <TextBlock x:Name="RefreshBtnText" Text="Actualizar" VerticalAlignment="Center" FontSize="11"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ClearStatsBtn" Style="{StaticResource StatsToolbarBtnStyle}" Height="30" Padding="10,4" Click="ClearStats_Click" ToolTip="Restablecer todas las estadísticas">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 3 6 H 21 M 8 6 V 4 A 2 2 0 0 1 10 2 H 14 A 2 2 0 0 1 16 4 V 6 M 19 6 V 20 A 2 2 0 0 1 17 22 H 7 A 2 2 0 0 1 5 20 V 6" Stroke="#EF4444" StrokeThickness="1.3" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ClearStatsBtnText" Text="Restablecer" VerticalAlignment="Center" FontSize="11"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Row 1: Main Dashboard Scrollable Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="DashboardView">
                    <!-- Top Row: 5 KPI Cards -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Total Events -->
                        <Border Grid.Column="0" Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Path Data="M 12 2 L 4 5 L 4 11 C 4 16.5 7.4 21.6 12 23 C 16.6 21.6 20 16.5 20 11 L 20 5 Z" Stroke="{DynamicResource SubTextBrush}" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" Fill="Transparent"/>
                                    <TextBlock x:Name="CardTotalTitle" Text="Total Eventos" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}"/>
                                </StackPanel>
                                <TextBlock x:Name="TotalEventsVal" Text="0" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                                <TextBlock x:Name="CardTotalDesc" Text="Eventos procesados" FontSize="10" Foreground="{DynamicResource SubTextBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Blocked Events -->
                        <Border Grid.Column="2" Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Path Data="M 12 2 A 10 10 0 1 0 12 22 A 10 10 0 1 0 12 2 Z M 4.93 4.93 L 19.07 19.07" Stroke="#FF4D6D" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" Fill="Transparent"/>
                                    <TextBlock x:Name="CardBlockedTitle" Text="Bloqueados" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock x:Name="BlockedEventsVal" Text="0" FontSize="18" FontWeight="Bold" Foreground="#FF4D6D"/>
                                    <TextBlock x:Name="BlockedPctVal" Text=" (0%)" FontSize="11" FontWeight="SemiBold" Foreground="#FF4D6D" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                                </StackPanel>
                                <TextBlock x:Name="CardBlockedDesc" Text="Amenazas y reglas" FontSize="10" Foreground="{DynamicResource SubTextBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Allowed Events -->
                        <Border Grid.Column="4" Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Path Data="M 12 2 A 10 10 0 1 0 12 22 A 10 10 0 1 0 12 2 Z M 7.5 12 L 10.5 15 L 16.5 9" Stroke="#00F5A0" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" Fill="Transparent"/>
                                    <TextBlock x:Name="CardAllowedTitle" Text="Permitidos" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock x:Name="AllowedEventsVal" Text="0" FontSize="18" FontWeight="Bold" Foreground="#00F5A0"/>
                                    <TextBlock x:Name="AllowedPctVal" Text=" (0%)" FontSize="11" FontWeight="SemiBold" Foreground="#00F5A0" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                                </StackPanel>
                                <TextBlock x:Name="CardAllowedDesc" Text="Tráfico permitido" FontSize="10" Foreground="{DynamicResource SubTextBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Session Data Volume -->
                        <Border Grid.Column="6" Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Path Data="M 12 3 L 12 15 M 12 15 L 8 11 M 12 15 L 16 11 M 4 19 L 20 19" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" Fill="Transparent"/>
                                    <TextBlock x:Name="CardVolumeTitle" Text="Volumen de Datos" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}"/>
                                </StackPanel>
                                <TextBlock x:Name="DataVolumeVal" Text="↓ 0.0 B" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,2" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="DataVolumeDesc" Text="↑ 0.0 B · Sesión" FontSize="10" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 5: Global Scope -->
                        <Border Grid.Column="8" Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Path Data="M 12 2 A 10 10 0 1 0 12 22 A 10 10 0 1 0 12 2 Z M 2 12 H 22 M 12 2 C 15 5.5 16.5 8.5 16.5 12 C 16.5 15.5 15 18.5 12 22 C 9 18.5 7.5 15.5 7.5 12 C 7.5 8.5 9 5.5 12 2 Z" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.2" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" Fill="Transparent"/>
                                    <TextBlock x:Name="CardScopeTitle" Text="Alcance Global" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}"/>
                                </StackPanel>
                                <TextBlock x:Name="ScopeVal" Text="0 países" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="CardScopeDesc" Text="0 apps · 0 IPs" FontSize="10" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Middle Section: 2 Columns of Analytics Cards -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN: Top Apps & Direction -->
                        <StackPanel Grid.Column="0">
                            <!-- Card: Top Applications -->
                            <Border Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M 12 2 L 2 7 L 12 12 L 22 7 Z M 2 17 L 12 22 L 22 17 M 2 12 L 12 17 L 22 12" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" Fill="Transparent"/>
                                            <TextBlock x:Name="TopAppsTitle" Text="Aplicaciones más Activas" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="Top 5" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Top Apps Items List -->
                                    <ItemsControl x:Name="TopAppsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3,0,5">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Grid Grid.Row="0" Margin="0,0,0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Image Grid.Column="0" Source="{Binding IconPath, Converter={StaticResource PathToIconConverter}}" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding TooltipText}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding CountFormatted}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                                                            <TextBlock Text=" ev." FontSize="10" Foreground="{DynamicResource SubTextBrush}"/>
                                                            <TextBlock Text=" (" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}"/>
                                                            <TextBlock Text="{Binding PercentageFormatted}" FontWeight="SemiBold" FontSize="10.5" Foreground="{DynamicResource AccentBrush}"/>
                                                            <TextBlock Text=")" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Border Grid.Row="1" Height="5" CornerRadius="2.5" Background="{DynamicResource CardSecondaryBrush}">
                                                        <ProgressBar Value="{Binding Percentage}" Maximum="100" Height="5" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource AccentBrush}"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Card: Traffic Direction -->
                            <Border Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M 4 8 H 18 M 14 4 L 18 8 L 14 12 M 20 16 H 6 M 10 12 L 6 16 L 10 20" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" Fill="Transparent"/>
                                            <TextBlock x:Name="TrafficDirTitle" Text="Flujo de Tráfico" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Outbound & Inbound stats -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="OutboundLbl" Text="Saliente (Outbound)" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock x:Name="OutboundCountVal" Text="0" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock x:Name="OutboundPctVal" Text=" (0%)" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Bottom" Margin="2,0,0,1"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock x:Name="InboundLbl" Text="Entrante (Inbound)" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                                <TextBlock x:Name="InboundCountVal" Text="0" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock x:Name="InboundPctVal" Text=" (0%)" FontSize="11" Foreground="#00F5A0" VerticalAlignment="Bottom" Margin="2,0,0,1"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Segmented Bar -->
                                    <Border Height="8" CornerRadius="4" Background="{DynamicResource CardSecondaryBrush}" ClipToBounds="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="ColOutboundBar" Width="50*"/>
                                                <ColumnDefinition x:Name="ColInboundBar" Width="50*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{DynamicResource AccentBrush}"/>
                                            <Border Grid.Column="1" Background="#00F5A0"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- RIGHT COLUMN: Top Countries -->
                        <Border Grid.Column="2" Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M 12 2 A 10 10 0 1 0 12 22 A 10 10 0 1 0 12 2 Z M 2 12 H 22 M 12 2 C 15 5.5 16.5 8.5 16.5 12 C 16.5 15.5 15 18.5 12 22 C 9 18.5 7.5 15.5 7.5 12 C 7.5 8.5 9 5.5 12 2 Z" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" Fill="Transparent"/>
                                        <TextBlock x:Name="TopCountriesTitle" Text="Países de Destino" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="Top 10" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Top Countries Items List -->
                                <ItemsControl x:Name="TopCountriesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4,0,6">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0" Margin="0,0,0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <ctrl:CountryFlagMark Grid.Column="0" CountryCode="{Binding CountryCode}" HasCountry="{Binding HasCountry}" ToolTip="{Binding CountryLabel}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding CountryLabel}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CountFormatted}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                                                        <TextBlock Text=" ev." FontSize="10" Foreground="{DynamicResource SubTextBrush}"/>
                                                        <TextBlock Text=" (" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}"/>
                                                        <TextBlock Text="{Binding PercentageFormatted}" FontWeight="SemiBold" FontSize="10.5" Foreground="{DynamicResource AccentBrush}"/>
                                                        <TextBlock Text=")" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <Border Grid.Row="1" Height="5" CornerRadius="2.5" Background="{DynamicResource CardSecondaryBrush}">
                                                    <ProgressBar Value="{Binding Percentage}" Maximum="100" Height="5" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource AccentBrush}"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Empty State -->
            <Border x:Name="EmptyState" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📊" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock x:Name="EmptyMsg" Text="No hay datos registrados en este período" Foreground="{DynamicResource SubTextBrush}" FontSize="13" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
