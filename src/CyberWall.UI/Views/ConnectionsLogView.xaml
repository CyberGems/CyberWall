<UserControl x:Class="CyberWall.UI.Views.ConnectionsLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CyberWall.UI.Converters"
             xmlns:ctrl="clr-namespace:CyberWall.UI.Controls"
             TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif">

    <UserControl.Resources>
        <conv:PathToIconConverter x:Key="PathToIconConverter"/>
        <conv:VerdictDisplayConverter x:Key="VerdictDisplayConverter"/>
        <conv:DirectionDisplayConverter x:Key="DirectionDisplayConverter"/>

        <!-- Action Button Style -->
        <Style x:Key="LogToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HeaderBgBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter Pill Style -->
        <Style x:Key="LogFilterRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="10,4" Margin="2,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardSecondaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ContextMenu -->
        <Style x:Key="LogContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="5" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.5" BlurRadius="16" ShadowDepth="4"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LogMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="8,0" SnapsToDevicePixels="True" Margin="0,1">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Icon" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="4,0,12,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource CardSecondaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="LogItemContextMenu" Style="{StaticResource LogContextMenuStyle}">
            <MenuItem Header="Buscar en línea" Style="{StaticResource LogMenuItemStyle}" Click="ContextSearch_Click">
                <MenuItem.Icon>
                    <Path Fill="{DynamicResource SubTextBrush}" Stretch="Uniform" Width="12" Height="12" Data="M6,1.2 C3.4,1.2 1.2,3.4 1.2,6 C1.2,8.6 3.4,10.8 6,10.8 C7.1,10.8 8.1,10.4 8.9,9.8 L11.1,12 L12,11.1 L9.8,8.9 C10.4,8.1 10.8,7.1 10.8,6 C10.8,3.4 8.6,1.2 6,1.2 Z"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Copiar destino" Style="{StaticResource LogMenuItemStyle}" Click="ContextCopyDest_Click">
                <MenuItem.Icon>
                    <Path Fill="{DynamicResource SubTextBrush}" Stretch="Uniform" Width="12" Height="12" Data="M4.2,3.4 H9.6 V9.2 H4.2 Z M6.2,1.6 H11.6 V7.4 H10.2 V3 H6.2 Z"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Abrir carpeta" Style="{StaticResource LogMenuItemStyle}" Click="ContextFolder_Click">
                <MenuItem.Icon>
                    <Path Fill="{DynamicResource SubTextBrush}" Stretch="Uniform" Width="12" Height="12" Data="M1,3 L1,10 L11,10 L11,5 L6.2,5 L5.2,3 Z"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <!-- Main Container Card -->
    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16,14">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 0: Toolbar -->
                <RowDefinition Height="Auto"/>
                <!-- 1: DataGrid -->
                <RowDefinition Height="*"/>
                <!-- 2: Footer info -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Filter & Action Toolbar -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Filter Box -->
                <Border Grid.Column="0" Height="34" CornerRadius="8" Background="{DynamicResource SearchBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                    <Grid Margin="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" FontSize="11" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="SearchPlaceholder" Text="Filtrar en el registro (app, IP, puerto)..." Foreground="{DynamicResource SubTextBrush}" FontSize="11.5" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.55"/>
                            <TextBox x:Name="SearchBox" Background="Transparent" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource AccentBrush}" BorderThickness="0" VerticalAlignment="Center" FontSize="11.5" TextChanged="SearchBox_TextChanged"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Status Filter Pills -->
                <Border Grid.Column="1" Margin="14,0,0,0" Background="{DynamicResource HeaderBgBrush}" CornerRadius="8" Padding="3,2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="FilterAllRadio" Content="Todos" GroupName="LogFilter" Style="{StaticResource LogFilterRadioStyle}" IsChecked="True" Checked="Filter_Checked"/>
                        <RadioButton x:Name="FilterBlockedRadio" Content="Bloqueados" GroupName="LogFilter" Style="{StaticResource LogFilterRadioStyle}" Checked="Filter_Checked"/>
                        <RadioButton x:Name="FilterAllowedRadio" Content="Permitidos" GroupName="LogFilter" Style="{StaticResource LogFilterRadioStyle}" Checked="Filter_Checked"/>
                    </StackPanel>
                </Border>

                <!-- Total Count Badge -->
                <Border Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="12,0,0,0">
                    <TextBlock x:Name="CountBadge" Text="0 registros" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                </Border>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RefreshBtn" Style="{StaticResource LogToolbarButtonStyle}" Margin="0,0,8,0" Click="Refresh_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 4 4 V 9 H 9 M 20 20 V 15 H 15 M 20 9 A 9 9 0 0 0 5.64 5.64 L 4 9 M 4 15 A 9 9 0 0 0 18.36 18.36 L 20 15" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" Fill="Transparent"/>
                            <TextBlock x:Name="RefreshBtnText" Text="Actualizar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CopyBtn" Style="{StaticResource LogToolbarButtonStyle}" Margin="0,0,8,0" Click="Copy_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 4 2 L 14 2 L 18 6 L 18 20 L 4 20 Z M 13 2 L 13 7 L 18 7 M 7 11 L 15 11 M 7 14 L 15 14 M 7 17 L 12 17" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.2" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CopyBtnText" Text="Copiar todo" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ClearBtn" Style="{StaticResource LogToolbarButtonStyle}" Margin="0,0,8,0" Click="Clear_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 3 6 H 21 M 8 6 V 4 A 2 2 0 0 1 10 2 H 14 A 2 2 0 0 1 16 4 V 6 M 19 6 V 20 A 2 2 0 0 1 17 22 H 7 A 2 2 0 0 1 5 20 V 6" Stroke="#EF4444" StrokeThickness="1.3" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ClearBtnText" Text="Limpiar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="OpenFileBtn" Style="{StaticResource LogToolbarButtonStyle}" Click="OpenFile_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 1 3 L 1 10 L 11 10 L 11 5 L 6.2 5 L 5.2 3 Z" Stroke="{DynamicResource SubTextBrush}" StrokeThickness="1.2" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" Fill="Transparent"/>
                            <TextBlock x:Name="OpenFileBtnText" Text="Abrir archivo" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Row 1: Connection Events Table -->
            <Border Grid.Row="1" Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                <Grid>
                    <DataGrid x:Name="LogGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" Background="Transparent" Foreground="{DynamicResource TextBrush}"
                              BorderThickness="0" GridLinesVisibility="None" CanUserAddRows="False"
                              CanUserSortColumns="True" AlternationCount="2" Margin="0"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ContextMenu="{StaticResource LogItemContextMenu}">
                        <DataGrid.Columns>
                            <!-- Date / Time -->
                            <DataGridTextColumn x:Name="ColTime" Header="Fecha / Hora" Binding="{Binding Timestamp}" Width="150" CanUserSort="True" SortMemberPath="Timestamp">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="12,0,6,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Action Badge -->
                            <DataGridTemplateColumn x:Name="ColAction" Header="Acción" Width="95" CanUserSort="True" SortMemberPath="Verdict">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Height="22" Padding="8,2" Margin="6,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource BadgeAllowBgBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Verdict}" Value="Block">
                                                            <Setter Property="Background" Value="{DynamicResource BadgeBlockBgBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Verdict, Converter={StaticResource VerdictDisplayConverter}}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource BadgeAllowFgBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Verdict}" Value="Block">
                                                                <Setter Property="Foreground" Value="{DynamicResource BadgeBlockFgBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Direction -->
                            <DataGridTemplateColumn x:Name="ColDir" Header="Dirección" Width="85" CanUserSort="True" SortMemberPath="Direction">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Height="22" Padding="6,2" Margin="6,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Direction, Converter={StaticResource DirectionDisplayConverter}}" Foreground="{DynamicResource SubTextBrush}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Program -->
                            <DataGridTemplateColumn x:Name="ColProg" Header="Programa" Width="1.4*" CanUserSort="True" SortMemberPath="DisplayName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0" ToolTip="{Binding AppPath}">
                                            <Image Source="{Binding AppPath, Converter={StaticResource PathToIconConverter}}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Country Flag -->
                            <DataGridTemplateColumn x:Name="ColCountry" Header="País" Width="55" CanUserSort="True" SortMemberPath="CountryLabel">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ctrl:CountryFlagMark CountryCode="{Binding CountryCode}" HasCountry="{Binding HasCountry}" ToolTip="{Binding CountryLabel}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Remote Endpoint / Destination -->
                            <DataGridTextColumn x:Name="ColDest" Header="Destino" Binding="{Binding RemoteEndpoint}" Width="2*" CanUserSort="True" SortMemberPath="RemoteEndpoint">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="8,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                        <Setter Property="FontSize" Value="11.5"/>
                                        <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding RemoteEndpoint}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- PID -->
                            <DataGridTextColumn x:Name="ColPid" Header="PID" Binding="{Binding ProcessId}" Width="65" CanUserSort="True" SortMemberPath="ProcessId">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="6,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty State -->
                    <Border x:Name="EmptyState" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📋" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock x:Name="EmptyMsg" Text="No hay registros grabados todavía" Foreground="{DynamicResource SubTextBrush}" FontSize="12.5" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Row 2: Footer Path Info -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="PathInfoText" Foreground="{DynamicResource SubTextBrush}" FontSize="10.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
