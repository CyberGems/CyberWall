<UserControl x:Class="CyberWall.UI.Views.TrafficMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CyberWall.UI.Converters"
             TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif">

    <UserControl.Resources>
        <conv:PathToIconConverter x:Key="PathToIconConverter"/>

        <!-- ContextMenu -->
        <Style x:Key="TrafficContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="5" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.5" BlurRadius="16" ShadowDepth="4"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrafficMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="8,0" SnapsToDevicePixels="True" Margin="0,1">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Icon" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="4,0,12,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource CardSecondaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="TrafficItemContextMenu" Style="{StaticResource TrafficContextMenuStyle}">
            <MenuItem Header="Buscar en línea" Style="{StaticResource TrafficMenuItemStyle}" Click="ContextSearch_Click">
                <MenuItem.Icon>
                    <Path Fill="{DynamicResource SubTextBrush}" Stretch="Uniform" Width="12" Height="12" Data="M6,1.2 C3.4,1.2 1.2,3.4 1.2,6 C1.2,8.6 3.4,10.8 6,10.8 C7.1,10.8 8.1,10.4 8.9,9.8 L11.1,12 L12,11.1 L9.8,8.9 C10.4,8.1 10.8,7.1 10.8,6 C10.8,3.4 8.6,1.2 6,1.2 Z"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Copiar ruta al portapapeles" Style="{StaticResource TrafficMenuItemStyle}" Click="ContextCopyPath_Click">
                <MenuItem.Icon>
                    <Path Fill="{DynamicResource SubTextBrush}" Stretch="Uniform" Width="12" Height="12" Data="M4.2,3.4 H9.6 V9.2 H4.2 Z M6.2,1.6 H11.6 V7.4 H10.2 V3 H6.2 Z"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Abrir carpeta del ejecutable" Style="{StaticResource TrafficMenuItemStyle}" Click="ContextFolder_Click">
                <MenuItem.Icon>
                    <Path Fill="{DynamicResource SubTextBrush}" Stretch="Uniform" Width="12" Height="12" Data="M1,3 L1,10 L11,10 L11,5 L6.2,5 L5.2,3 Z"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: KPI Stats Cards -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Live 60s Telemetry Chart -->
            <RowDefinition Height="185" MinHeight="150"/>
            <!-- 2: Top Active Bandwidth Consumers -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: KPI Cards -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Download KPI Card -->
            <Border Grid.Column="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Text="↓" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock x:Name="DownTitleLbl" Text="Descarga Actual" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="DownCurrentSpeedVal" Grid.Row="1" Text="0.0 B/s" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,4,0,2"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock x:Name="DownPeakLbl" Text="Pico (60s): " FontSize="10.5" Foreground="{DynamicResource SubTextBrush}"/>
                        <TextBlock x:Name="DownPeakVal" Text="0.0 B/s" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Upload KPI Card -->
            <Border Grid.Column="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Text="↑" Foreground="#22C55E" FontWeight="Bold" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock x:Name="UpTitleLbl" Text="Subida Actual" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="UpCurrentSpeedVal" Grid.Row="1" Text="0.0 B/s" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,4,0,2"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock x:Name="UpPeakLbl" Text="Pico (60s): " FontSize="10.5" Foreground="{DynamicResource SubTextBrush}"/>
                        <TextBlock x:Name="UpPeakVal" Text="0.0 B/s" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Active Adapter Card -->
            <Border Grid.Column="4" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Text="🛜" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AdapterHeaderLbl" Text="Adaptador Activo" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="AdapterValueLbl" Grid.Row="1" Text="Conectado" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,6,0,2" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock x:Name="AppsActiveLbl" Text="Transmitiendo: " FontSize="10.5" Foreground="{DynamicResource SubTextBrush}"/>
                        <TextBlock x:Name="AppsActiveCountVal" Text="0 apps" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Session Data Card -->
            <Border Grid.Column="6" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Text="📊" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SessionTitleLbl" Text="Transferencia en Sesión" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,2">
                        <TextBlock Text="↓ " Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="12"/>
                        <TextBlock x:Name="DownTotalVal" Text="0 B" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="↑ " Foreground="#22C55E" FontWeight="Bold" FontSize="12"/>
                        <TextBlock x:Name="UpTotalVal" Text="0 B" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock x:Name="DownAvgLbl" Text="Promedio: " FontSize="10.5" Foreground="{DynamicResource SubTextBrush}"/>
                        <TextBlock x:Name="DownAvgVal" Text="0.0 B/s" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 1: Live 60s Telemetry Chart -->
        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Chart Header: Peak Scale + Legend -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ChartTitleText" Text="Telemetría en Vivo (Últimos 60 segundos)" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>

                    <!-- Legend & Peak Pill -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource CardSecondaryBrush}" CornerRadius="6" Padding="6,2" Margin="0,0,12,0">
                            <TextBlock x:Name="ChartPeakRateText" Text="▲ 0 B/s" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>

                        <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LegendDownText" Text="Descarga" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>

                        <Ellipse Width="8" Height="8" Fill="#22C55E" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LegendUpText" Text="Subida" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Canvas Graph Area with Grid lines -->
                <Border Grid.Row="1" Background="{DynamicResource HeaderBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                    <Grid x:Name="ChartContainer" SizeChanged="ChartContainer_SizeChanged">
                        <!-- Subtle Horizontal Grid Lines -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Opacity="0.3"/>
                            <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Opacity="0.3"/>
                        </Grid>

                        <Canvas x:Name="ChartCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <!-- Download Area Gradient -->
                            <Path x:Name="DownloadAreaPath">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#250284C7" Offset="0"/>
                                        <GradientStop Color="#000284C7" Offset="1"/>
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>
                            <!-- Upload Area Gradient -->
                            <Path x:Name="UploadAreaPath">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#2522C55E" Offset="0"/>
                                        <GradientStop Color="#0022C55E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>
                            <!-- Lines -->
                            <Path x:Name="DownloadLinePath" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Path x:Name="UploadLinePath" Stroke="#22C55E" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Grid>
                </Border>

                <!-- Time Axis Labels -->
                <Grid Grid.Row="2" Margin="4,4,4,0">
                    <TextBlock Text="-60s" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Left"/>
                    <TextBlock Text="-45s" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" Margin="-160,0,0,0"/>
                    <TextBlock Text="-30s" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="-15s" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" Margin="160,0,0,0"/>
                    <TextBlock x:Name="TimeNowLbl" Text="Ahora" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Row 2: Ranked Active Bandwidth Consumers -->
        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Consumers Section Header -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="6" Background="#261E0A" BorderBrush="#854D0E" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Path Data="M 7 1 L 2 8 L 6 8 L 5 14 L 11 6 L 7 6 Z" Fill="#FBBF24" Width="10" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ConsumersTitle" Text="Procesos con Mayor Tráfico Activo" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock x:Name="ConsumersSubTitle" Text="Velocidad de subida y bajada en tiempo real por proceso" FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Background="{DynamicResource CardSecondaryBrush}" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                        <TextBlock x:Name="TotalThroughputText" Text="↓ 0.0 B/s  ↑ 0.0 B/s" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                </Grid>

                <!-- Consumers List / Empty State -->
                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ConsumersList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,2,0,4" Padding="10,7" Background="{DynamicResource CardSecondaryBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            ContextMenu="{StaticResource TrafficItemContextMenu}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="190"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- App Icon -->
                                            <Image Grid.Column="0" Source="{Binding AppPath, Converter={StaticResource PathToIconConverter}}" Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                                            <!-- App Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding AppPath}" FontSize="10" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding AppPath}"/>
                                            </StackPanel>

                                            <!-- Usage Progress Bar -->
                                            <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <ProgressBar Height="5" Value="{Binding UsagePercent}" Maximum="100"
                                                             Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource HeaderBgBrush}"
                                                             BorderThickness="0"/>
                                            </Grid>

                                            <!-- Speeds -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0">
                                                <TextBlock Text="↓ " Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding FormattedDownload}" Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="SemiBold" Width="68"/>
                                                <TextBlock Text="↑ " Foreground="#22C55E" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding FormattedUpload}" Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="SemiBold" Width="68"/>
                                            </StackPanel>

                                            <!-- Quick Block Button -->
                                            <Button Grid.Column="4" Content="{Binding QuickBlockText}" Tag="{Binding AppPath}"
                                                    Click="QuickBlock_Click"
                                                    Background="#2D1518" BorderBrush="#E81123" Foreground="#FF6B6B"
                                                    FontSize="11" FontWeight="SemiBold" Padding="10,4"
                                                    Cursor="Hand" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="BtnBd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="BtnBd" Property="Background" Value="#E81123"/>
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Minimalist Empty State -->
                    <Border x:Name="EmptyStateBorder" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="💤" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock x:Name="EmptyStateText" Text="No hay aplicaciones consumiendo tráfico en este momento" Foreground="{DynamicResource SubTextBrush}" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
