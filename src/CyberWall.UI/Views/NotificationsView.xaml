<UserControl x:Class="CyberWall.UI.Views.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CyberWall.UI.Converters"
             TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif">

    <UserControl.Resources>
        <conv:PathToIconConverter x:Key="PathToIconConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBgBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HeaderBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ItemActionButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="13,6"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ItemBlockButton" TargetType="Button" BasedOn="{StaticResource ItemActionButton}">
            <Setter Property="Background" Value="{DynamicResource BadgeBlockBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BadgeBlockFgBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,4,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Header Info Hero Card -->
        <Border Grid.Row="0" MaxWidth="960" HorizontalAlignment="Stretch"
                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="16,0,16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource CardSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Path Data="M 6,8 C 6,4.7 8.7,2 12,2 C 15.3,2 18,4.7 18,8 L 18,13 L 21,17 L 3,17 L 6,13 Z M 10.2,20 C 10.6,21.2 11.2,22 12,22 C 12.8,22 13.4,21.2 13.8,20"
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Width="16" Height="17" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Fill="Transparent"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleLbl" Text="Notificaciones" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="CountBadge" Text="0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="SubtitleLbl" Text="Alertas de seguridad, decisiones pendientes e historial de actualizaciones"
                               FontSize="12.5" Foreground="{DynamicResource SubTextBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MarkReadBtn" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="MarkAllRead_Click">
                        <TextBlock x:Name="MarkReadBtnText" Text="Marcar como leídas"/>
                    </Button>
                    <Button x:Name="ClearBtn" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="Clear_Click">
                        <TextBlock x:Name="ClearBtnText" Text="Vaciar"/>
                    </Button>
                    <Button x:Name="SettingsBtn" Style="{StaticResource SecondaryButtonStyle}" Width="34" Padding="0" Margin="0,0,8,0" Click="Settings_Click">
                        <Path Data="M 12 15 C 10.3 15 9 13.7 9 12 C 9 10.3 10.3 9 12 9 C 13.7 9 15 10.3 15 12 C 15 13.7 13.7 15 12 15 Z M 19.4 13 C 19.5 12.7 19.5 12.3 19.5 12 C 19.5 11.7 19.5 11.3 19.4 11 L 21.5 9.4 C 21.7 9.2 21.8 8.9 21.6 8.7 L 19.6 5.2 C 19.5 5 19.2 4.9 19 5 L 16.5 6 C 16 5.6 15.4 5.3 14.8 5.1 L 14.4 2.4 C 14.4 2.2 14.2 2 13.9 2 L 10.1 2 C 9.8 2 9.6 2.2 9.6 2.4 L 9.2 5.1 C 8.6 5.3 8 5.6 7.5 6 L 5 5 C 4.8 4.9 4.5 5 4.4 5.2 L 2.4 8.7 C 2.2 8.9 2.3 9.2 2.5 9.4 L 4.6 11 C 4.5 11.3 4.5 11.7 4.5 12 C 4.5 12.3 4.5 12.7 4.6 13 L 2.5 14.6 C 2.3 14.8 2.2 15.1 2.4 15.3 L 4.4 18.8 C 4.5 19 4.8 19.1 5 19 L 7.5 18 C 8 18.4 8.6 18.7 9.2 18.9 L 9.6 21.6 C 9.6 21.8 9.8 22 10.1 22 L 13.9 22 C 14.2 22 14.4 21.8 14.4 21.6 L 14.8 18.9 C 15.4 18.7 16 18.4 16.5 18 L 19 19 C 19.2 19.1 19.5 19 19.6 18.8 L 21.6 15.3 C 21.8 15.1 21.7 14.8 21.5 14.6 L 19.4 13 Z"
                              Fill="{DynamicResource AccentBrush}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BackBtn" Style="{StaticResource SecondaryButtonStyle}" Click="BackBtn_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 15 18 L 9 12 L 15 6" Stroke="{DynamicResource SubTextBrush}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="10" Height="10" Stretch="Uniform" Fill="Transparent" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BackBtnText" Text="Volver" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Active Pause Banner -->
        <Border x:Name="PausedBanner" Grid.Row="1" MaxWidth="960" HorizontalAlignment="Stretch"
                Visibility="Collapsed" Margin="16,0,16,12" CornerRadius="10"
                Background="{DynamicResource BadgeWarnBgBrush}" BorderBrush="{DynamicResource BadgeWarnFgBrush}" BorderThickness="1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Path Data="M 6,8 C 6,4.7 8.7,2 12,2 C 15.3,2 18,4.7 18,8 L 18,13 L 21,17 L 3,17 L 6,13 Z M 10.2,20 C 10.6,21.2 11.2,22 12,22 C 12.8,22 13.4,21.2 13.8,20 M 3,3 L 21,21"
                      Stroke="{DynamicResource BadgeWarnFgBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0" Fill="Transparent"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="PausedBannerTitle" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="PausedBannerDesc" FontSize="11.5" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
                <Button x:Name="PausedResumeBtn" Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Height="30" Padding="12,0" VerticalAlignment="Center" Click="PausedResume_Click"/>
            </Grid>
        </Border>

        <!-- Row 2: Notifications List / Empty State -->
        <Grid Grid.Row="2" MaxWidth="960" HorizontalAlignment="Stretch" Margin="16,0,16,4">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                <ItemsControl x:Name="NotifList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" CornerRadius="10" BorderThickness="1" Padding="14,11" SnapsToDevicePixels="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Highlight}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource CardSecondaryBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsResolved}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource BadgeAllowBgBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource BadgeAllowFgBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsBlockedResolved}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource BadgeBlockBgBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource BadgeBlockFgBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Top">
                                        <Border CornerRadius="8" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource CardSecondaryBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInternetLost}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource BadgeBlockBgBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource BadgeBlockFgBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsInternetRestored}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource BadgeAllowBgBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource BadgeAllowFgBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsProtectionOff}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource BadgeWarnBgBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource BadgeWarnFgBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsUpdate}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource HeaderBgBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image Source="{Binding AppPath, Converter={StaticResource PathToIconConverter}}" Width="20" Height="20" Visibility="{Binding HasAppIcon, Converter={StaticResource BoolToVis}}" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Path Data="M 12,19 L 12,19.01 M 8.5,15.5 C 10.5,13.8 13.5,13.8 15.5,15.5 M 5.5,12 C 9.2,8.5 14.8,8.5 18.5,12 M 2.5,8.5 C 8,3.5 16,3.5 21.5,8.5 M 3,3 L 21,21" Stroke="{DynamicResource BadgeBlockFgBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="Transparent" Visibility="{Binding IsInternetLost, Converter={StaticResource BoolToVis}}"/>
                                                <Path Data="M 12,19 L 12,19.01 M 8.5,15.5 C 10.5,13.8 13.5,13.8 15.5,15.5 M 5.5,12 C 9.2,8.5 14.8,8.5 18.5,12 M 2.5,8.5 C 8,3.5 16,3.5 21.5,8.5" Stroke="{DynamicResource BadgeAllowFgBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="Transparent" Visibility="{Binding IsInternetRestored, Converter={StaticResource BoolToVis}}"/>
                                                <Path Data="M 12,2 L 4,5 L 4,11 C 4,16.5 7.5,21.3 12,22.5 C 16.5,21.3 20,16.5 20,11 L 20,5 Z M 12,7 L 12,13 M 12,16 L 12,17" Stroke="{DynamicResource BadgeWarnFgBrush}" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="Transparent" Visibility="{Binding IsProtectionOff, Converter={StaticResource BoolToVis}}"/>
                                                <Path Data="M 12,3 L 12,14 M 7.5,10 L 12,14.5 L 16.5,10 M 4,18 L 20,18" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="Transparent" Visibility="{Binding IsUpdate, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TimeLabel}" Foreground="{DynamicResource SubTextBrush}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource SubTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <Button Style="{StaticResource ItemActionButton}" Tag="{Binding}" Click="Action_Click" IsEnabled="{Binding CanAct}" Visibility="{Binding ShowAction, Converter={StaticResource BoolToVis}}" Content="{Binding ActionLabel}"/>
                                        <Button Style="{StaticResource ItemBlockButton}" Tag="{Binding}" Click="Block_Click" IsEnabled="{Binding CanBlock}" Visibility="{Binding ShowBlockAction, Converter={StaticResource BoolToVis}}" Content="{Binding BlockLabel}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border x:Name="EmptyStateCard" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <Path Data="M 6,8 C 6,4.7 8.7,2 12,2 C 15.3,2 18,4.7 18,8 L 18,13 L 21,17 L 3,17 L 6,13 Z M 10.2,20 C 10.6,21.2 11.2,22 12,22 C 12.8,22 13.4,21.2 13.8,20"
                          Stroke="{DynamicResource SubTextBrush}" StrokeThickness="1.3" Width="28" Height="28" Stretch="Uniform"
                          Opacity="0.6" HorizontalAlignment="Center" Margin="0,0,0,10" Fill="Transparent"/>
                    <TextBlock x:Name="EmptyMsg" Text="Todavía no hay notificaciones." Foreground="{DynamicResource SubTextBrush}" FontSize="13.5" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

