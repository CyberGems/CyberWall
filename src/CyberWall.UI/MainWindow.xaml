                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="False">
                                                                <Setter TargetName="QuickRemoveBtn" Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                                <Setter TargetName="QuickRemoveBtn" Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- App Path -->
                                            <DataGridTextColumn Binding="{Binding AppPath}" Width="2.2*" CanUserSort="True" SortMemberPath="AppPath">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Margin" Value="12,0"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
                                                        <Setter Property="FontSize" Value="11"/>
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                        <Setter Property="ToolTip" Value="{Binding AppPath}"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <!-- Sleek Compact Action Pill Badge -->
                                            <DataGridTemplateColumn Width="100" CanUserSort="True" SortMemberPath="Verdict">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource BadgeAllowBgBrush}" CornerRadius="6" Height="22" Padding="8,2" Margin="6,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding Verdict, Converter={StaticResource VerdictDisplayConverter}}" Foreground="{DynamicResource BadgeAllowFgBrush}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Sleek Compact Direction Tag -->
                                            <DataGridTemplateColumn Width="100" CanUserSort="True" SortMemberPath="Direction">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Height="22" Padding="6,2" Margin="6,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding Direction, Converter={StaticResource DirectionDisplayConverter}}" Foreground="{DynamicResource SubTextBrush}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Expander>
                            </Border>

                            <!-- Blocked Section -->
                            <Border CornerRadius="8" Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Expander x:Name="BlockedExpander" Header="Bloqueadas (0)" IsExpanded="True" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="13" Padding="0,6" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <DataGrid x:Name="BlockedGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="None" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" GridLinesVisibility="None" CanUserAddRows="False" CanUserSortColumns="True" AlternationCount="2" Margin="0,4,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="DataGrid_PreviewMouseWheel">
                                        <DataGrid.Columns>
                                            <!-- Switch Column -->
                                            <DataGridTemplateColumn Width="64" CanUserSort="False">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding Verdict, Converter={StaticResource VerdictToToggleConverter}, Mode=TwoWay}" Style="{StaticResource MiniToggle}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="RuleToggle_Click"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Program Name + Clean Bare Icon + Inline Delete Button on Hover -->
                                            <DataGridTemplateColumn Width="1.4*" SortMemberPath="DisplayName" CanUserSort="True">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="12,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Image Source="{Binding AppPath, Converter={StaticResource PathToIconConverter}}" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <Button x:Name="QuickRemoveBtn" Grid.Column="2" Content="✕" Style="{StaticResource RowDeleteButton}" ToolTip="Eliminar regla" Tag="{Binding}" Click="QuickRemove_Click" Margin="6,0,0,0"/>
                                                        </Grid>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="False">
                                                                <Setter TargetName="QuickRemoveBtn" Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                                <Setter TargetName="QuickRemoveBtn" Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- App Path -->
                                            <DataGridTextColumn Binding="{Binding AppPath}" Width="2.2*" CanUserSort="True" SortMemberPath="AppPath">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Margin" Value="12,0"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
                                                        <Setter Property="FontSize" Value="11"/>
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                        <Setter Property="ToolTip" Value="{Binding AppPath}"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <!-- Sleek Compact Action Pill Badge -->
                                            <DataGridTemplateColumn Width="100" CanUserSort="True" SortMemberPath="Verdict">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource BadgeBlockBgBrush}" CornerRadius="6" Height="22" Padding="8,2" Margin="6,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding Verdict, Converter={StaticResource VerdictDisplayConverter}}" Foreground="{DynamicResource BadgeBlockFgBrush}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Sleek Compact Direction Tag -->
                                            <DataGridTemplateColumn Width="100" CanUserSort="True" SortMemberPath="Direction">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Height="22" Padding="6,2" Margin="6,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding Direction, Converter={StaticResource DirectionDisplayConverter}}" Foreground="{DynamicResource SubTextBrush}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Expander>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Footer / Status Bar -->
            <Border Grid.Row="3" Margin="0,10,0,0">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource SubTextBrush}" FontSize="11" Text="Windows 10/11 • WFP Kernel Engine • Admin Privileges Active • Persistent Rules"/>
                        <TextBlock x:Name="OpenLogLink" Margin="14,0,0,0" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="11" Cursor="Hand" Text="Registro de conexiones" MouseLeftButtonDown="OpenLog_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="LogPathText" HorizontalAlignment="Right" Foreground="{DynamicResource SubTextBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
