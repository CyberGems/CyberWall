<Window x:Class="CyberWall.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberWall" Height="660" Width="1020" WindowStartupLocation="CenterScreen" Background="#0D1117">
    <Window.Resources>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C9D1D9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#161B22"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="#1A1F29"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#21262D"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1F6FEB"/><Setter Property="Foreground" Value="White"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="Track" Width="52" Height="28" CornerRadius="14" Background="#21262D" BorderBrush="#30363D" BorderThickness="1"/>
                            <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="#8B949E" HorizontalAlignment="Left" Margin="4,0,0,0"/>
                            <ContentPresenter Margin="60,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#1F6FEB"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#1F6FEB"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel>
            <TextBlock x:Name="TitleText" Text="CyberWall" FontSize="22" FontWeight="Bold" Foreground="#E6EDF3" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ComboBox x:Name="LangBox" Width="120" Height="28" SelectionChanged="LangBox_SelectionChanged">
                    <ComboBoxItem Content="Español"/><ComboBoxItem Content="English"/>
                </ComboBox>
                <Button Content="Probar popup" Margin="8,0,0,0" Padding="10,6" Background="#21262D" Foreground="#E6EDF3" BorderThickness="1" BorderBrush="#30363D" Click="TestPopup_Click"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" CornerRadius="12" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" Padding="16" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="MasterToggle" Style="{StaticResource ToggleSwitch}" Checked="MasterToggle_Changed" Unchecked="MasterToggle_Changed"/>
                    <TextBlock x:Name="MasterLabel" Text="Firewall ACTIVADO" Foreground="#E6EDF3" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Foreground="#8B949E" FontSize="12" TextWrapping="Wrap" Text="Activado — preguntando por apps desconocidas (bloqueo por defecto)"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Modo:" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="ModeBox" Width="200" Height="30" SelectionChanged="ModeBox_SelectionChanged">
                        <ComboBoxItem Content="Preguntar para conectar"/>
                        <ComboBoxItem Content="Bloquear todo"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" CornerRadius="12" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" Padding="12" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel>
                    <TextBox x:Name="SearchBox" Width="260" Height="30" VerticalAlignment="Center" Background="#0D1117" Foreground="#E6EDF3" BorderBrush="#30363D" TextChanged="SearchBox_TextChanged"/>
                    <TextBlock Text="  Reglas por programa — cada .exe nuevo dispara popup (no por IP)" Foreground="#6E7681" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                        <Button Content="Quitar regla" Padding="10,6" Background="#21262D" Foreground="#E6EDF3" BorderBrush="#30363D" BorderThickness="1" Click="Remove_Click"/>
                    </StackPanel>
                </DockPanel>
                <DataGrid x:Name="RulesGrid" Grid.Row="1" Margin="0,10,0,0" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="#161B22" Foreground="#E6EDF3" RowBackground="#161B22" AlternatingRowBackground="#1A1F29" BorderBrush="#30363D" GridLinesVisibility="None">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Programa" Binding="{Binding DisplayName}" Width="*"/>
                        <DataGridTextColumn Header="Ruta" Binding="{Binding AppPath}" Width="2*"/>
                        <DataGridTextColumn Header="Veredicto" Binding="{Binding Verdict}" Width="110"/>
                        <DataGridTextColumn Header="Dirección" Binding="{Binding Direction}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
        <TextBlock Grid.Row="3" Margin="0,10,0,0" Foreground="#484F58" FontSize="11" Text="Windows 10/11 • WFP • Instalador con Servicio (SYSTEM) • Requiere Admin para activar filtros • Filtros persistentes"/>
    </Grid>
</Window>
