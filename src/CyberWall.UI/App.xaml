<Application x:Class="CyberWall.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#0A0F14"/>
        <SolidColorBrush x:Key="CardBrush" Color="#141B22"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#243040"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E6EDF3"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#8B949E"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#1F6FEB"/>
        <SolidColorBrush x:Key="AccentFgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="GridAltBrush" Color="#101820"/>
        <SolidColorBrush x:Key="HeaderBgBrush" Color="#1A2532"/>
    </Application.Resources>
</Application>
