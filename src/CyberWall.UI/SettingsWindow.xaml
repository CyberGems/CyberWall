<Window x:Class="CyberWall.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CyberWall.UI.Controls"
        Title="Settings" Height="650" Width="560" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif">

    <Window.Resources>
        <!-- Custom Title Close Button -->
        <Style x:Key="TitleCloseButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Unified Primary Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Unified Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HeaderBgBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Position Block Style for Grid Selector -->
        <Style x:Key="PositionBlockStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HeaderBgBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="TemplateRoot" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource SubTextBrush}" Data="M 0 0 L 4 4 L 8 0 Z"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" Template="{StaticResource ComboBoxToggleButton}" Grid.Column="2" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,3,28,3" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Margin="0,4,0,4">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="12" ShadowDepth="4"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource HeaderBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox Switch Style -->
        <Style x:Key="ModernToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border x:Name="Track" Width="40" Height="22" CornerRadius="11" Background="{DynamicResource SwitchTrackBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.2"/>
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="#CBD5E1" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="Black" Opacity="0.25" BlurRadius="3" ShadowDepth="1"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Custom Window Frame Container with Smooth Anti-Aliasing Buffer Margin -->
    <Border Margin="5" CornerRadius="12">
        <Border x:Name="OuterBorder" CornerRadius="12" ClipToBounds="True" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource BgBrush}" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="WindowScale" ScaleX="1" ScaleY="1"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect x:Name="WindowGlow" Color="#2563EB" Opacity="0" BlurRadius="20" ShadowDepth="0"/>
            </Border.Effect>
            <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0" Padding="18,12" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 12 15 C 10.3 15 9 13.7 9 12 C 9 10.3 10.3 9 12 9 C 13.7 9 15 10.3 15 12 C 15 13.7 13.7 15 12 15 Z M 19.4 13 C 19.5 12.7 19.5 12.3 19.5 12 C 19.5 11.7 19.5 11.3 19.4 11 L 21.5 9.4 C 21.7 9.2 21.8 8.9 21.6 8.7 L 19.6 5.2 C 19.5 5 19.2 4.9 19 5 L 16.5 6 C 16 5.6 15.4 5.3 14.8 5.1 L 14.4 2.4 C 14.4 2.2 14.2 2 13.9 2 L 10.1 2 C 9.8 2 9.6 2.2 9.6 2.4 L 9.2 5.1 C 8.6 5.3 8 5.6 7.5 6 L 5 5 C 4.8 4.9 4.5 5 4.4 5.2 L 2.4 8.7 C 2.2 8.9 2.3 9.2 2.5 9.4 L 4.6 11 C 4.5 11.3 4.5 11.7 4.5 12 C 4.5 12.3 4.5 12.7 4.6 13 L 2.5 14.6 C 2.3 14.8 2.2 15.1 2.4 15.3 L 4.4 18.8 C 4.5 19 4.8 19.1 5 19 L 7.5 18 C 8 18.4 8.6 18.7 9.2 18.9 L 9.6 21.6 C 9.6 21.8 9.8 22 10.1 22 L 13.9 22 C 14.2 22 14.4 21.8 14.4 21.6 L 14.8 18.9 C 15.4 18.7 16 18.4 16.5 18 L 19 19 C 19.2 19.1 19.5 19 19.6 18.8 L 21.6 15.3 C 21.8 15.1 21.7 14.8 21.5 14.6 L 19.4 13 Z" Fill="{DynamicResource AccentBrush}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="TitleLbl" Text="Configuración" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕" Style="{StaticResource TitleCloseButton}" HorizontalAlignment="Right" Click="Close_Click"/>
                </Grid>
            </Border>

            <!-- Settings Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="22,16,22,14">
                <StackPanel>
                    <!-- Language Section -->
                    <TextBlock x:Name="LangLbl" Text="Idioma de la interfaz" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                    <ComboBox x:Name="LangBox" Height="36" Style="{StaticResource ModernComboBox}" SelectionChanged="Lang_Changed">
                        <ComboBoxItem Content="Español (Spanish)"/>
                        <ComboBoxItem Content="English"/>
                    </ComboBox>

                    <!-- Theme Section with CyberSnap-style visual Theme Cards -->
                    <TextBlock x:Name="ThemeLbl" Text="Tema de la aplicación" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,16,0,4"/>
                    <TextBlock x:Name="ThemeSubLbl" Text="Elige el aspecto visual característico de CyberWall." Foreground="{DynamicResource SubTextBrush}" FontSize="11" Margin="0,0,0,8"/>

                    <Border CornerRadius="12" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <controls:ThemeCard x:Name="CyberWallCard" ThemeMode="CyberWall" Caption="CyberWall" CardWidth="130" Margin="5,0,5,0" Checked="ThemeCard_Checked"/>
                                <controls:ThemeCard x:Name="DarkCard" ThemeMode="Dark" Caption="Oscuro" CardWidth="130" Margin="5,0,5,0" Checked="ThemeCard_Checked"/>
                                <controls:ThemeCard x:Name="LightCard" ThemeMode="Light" Caption="Claro" CardWidth="130" Margin="5,0,5,0" Checked="ThemeCard_Checked"/>
                            </StackPanel>
                            <TextBlock x:Name="InstantChangeLbl" Margin="0,8,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" FontSize="11" Text="Se aplica al instante sin necesidad de reiniciar la aplicación."/>
                        </StackPanel>
                    </Border>

                    <!-- Ubicación / Location Section (CyberSnap / CyberFeeds style) -->
                    <TextBlock x:Name="LocationHdrLbl" Text="Ubicación" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="14" Margin="0,18,0,8"/>

                    <Border CornerRadius="12" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16,12">
                        <StackPanel>
                            <!-- Row 1: Notification Position Grid Picker -->
                            <Grid Margin="0,4,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Path Data="M 3 4 L 17 4 L 17 14 L 3 14 Z M 3 7 L 17 7" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3" Fill="Transparent" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Description -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="PosTitleLbl" Text="Posición de notificación" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock x:Name="PosDescLbl" Text="Elegir dónde aparecen las alertas de conexión." FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- 16:9 Landscape Monitor Frame with 3x3 Position Grid -->
                                <Border Grid.Column="2" Width="150" Height="90" CornerRadius="8" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4,4" VerticalAlignment="Center">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Top Row -->
                                        <Border x:Name="PosBlock_TopLeft" Grid.Row="0" Grid.Column="0" Margin="2" Style="{StaticResource PositionBlockStyle}" Tag="TopLeft" MouseLeftButtonDown="PositionBlock_Click">
                                            <Border x:Name="PosDot_TopLeft" Width="8" Height="8" CornerRadius="2" Background="#40808080" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3"/>
                                        </Border>
                                        <Border x:Name="PosBlock_TopCenter" Grid.Row="0" Grid.Column="1" Margin="2" Style="{StaticResource PositionBlockStyle}" Tag="TopCenter" MouseLeftButtonDown="PositionBlock_Click">
                                            <Border x:Name="PosDot_TopCenter" Width="8" Height="8" CornerRadius="2" Background="#40808080" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="3"/>
                                        </Border>
                                        <Border x:Name="PosBlock_TopRight" Grid.Row="0" Grid.Column="2" Margin="2" Style="{StaticResource PositionBlockStyle}" Tag="TopRight" MouseLeftButtonDown="PositionBlock_Click">
                                            <Border x:Name="PosDot_TopRight" Width="8" Height="8" CornerRadius="2" Background="#40808080" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="3"/>
                                        </Border>

                                        <!-- Middle Row -->
                                        <Border x:Name="PosBlock_Left" Grid.Row="1" Grid.Column="0" Margin="2" Style="{StaticResource PositionBlockStyle}" Tag="Left" MouseLeftButtonDown="PositionBlock_Click">
                                            <Border x:Name="PosDot_Left" Width="8" Height="8" CornerRadius="2" Background="#40808080" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3"/>
                                        </Border>
                                        <!-- Center subtle dot (decorative) -->
                                        <Border Grid.Row="1" Grid.Column="1" Margin="2" IsHitTestVisible="False" Opacity="0.2">
                                            <Border Width="6" Height="6" CornerRadius="2" Background="#40808080" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="PosBlock_Right" Grid.Row="1" Grid.Column="2" Margin="2" Style="{StaticResource PositionBlockStyle}" Tag="Right" MouseLeftButtonDown="PositionBlock_Click">
                                            <Border x:Name="PosDot_Right" Width="8" Height="8" CornerRadius="2" Background="#40808080" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="3"/>
                                        </Border>

                                        <!-- Bottom Row -->
                                        <Border x:Name="PosBlock_BottomLeft" Grid.Row="2" Grid.Column="0" Margin="2" Style="{StaticResource PositionBlockStyle}" Tag="BottomLeft" MouseLeftButtonDown="PositionBlock_Click">
                                            <Border x:Name="PosDot_BottomLeft" Width="8" Height="8" CornerRadius="2" Background="#40808080" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="3"/>
                                        </Border>
                                        <Border x:Name="PosBlock_BottomCenter" Grid.Row="2" Grid.Column="1" Margin="2" Style="{StaticResource PositionBlockStyle}" Tag="BottomCenter" MouseLeftButtonDown="PositionBlock_Click">
                                            <Border x:Name="PosDot_BottomCenter" Width="8" Height="8" CornerRadius="2" Background="#40808080" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="3"/>
                                        </Border>
                                        <Border x:Name="PosBlock_BottomRight" Grid.Row="2" Grid.Column="2" Margin="2" Style="{StaticResource PositionBlockStyle}" Tag="BottomRight" MouseLeftButtonDown="PositionBlock_Click">
                                            <Border x:Name="PosDot_BottomRight" Width="8" Height="8" CornerRadius="2" Background="#40808080" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="3"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Separator -->
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,6,0,10"/>

                            <!-- Row 2: Notification Monitor Selector -->
                            <Grid Margin="0,4,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Monitor Icon -->
                                <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Path Data="M 2 3 L 18 3 L 18 13 L 2 13 Z M 8 13 L 8 16 L 12 16 L 12 13 M 6 16 L 14 16" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3" Fill="Transparent" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="MonTitleLbl" Text="Monitor de notificación" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock x:Name="MonDescLbl" Text="Elegir en qué monitor mostrar los avisos." FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <ComboBox x:Name="MonBox" Grid.Column="2" Width="180" Height="34" Style="{StaticResource ModernComboBox}" SelectionChanged="MonBox_SelectionChanged"/>
                            </Grid>

                            <!-- Separator -->
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4,0,10"/>

                            <!-- Row 3: Sound Alert Toggle -->
                            <Grid Margin="0,4,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Speaker Icon -->
                                <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Path Data="M 11 5 L 6 9 L 2 9 L 2 15 L 6 15 L 11 19 Z M 15.54 8.46 A 5 5 0 0 1 15.54 15.54 M 19.07 4.93 A 10 10 0 0 1 19.07 19.07" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3" Fill="Transparent" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="SoundTitleLbl" Text="Reproducir sonido en avisos de red" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock x:Name="SoundDescLbl" Text="Emite un tono suave cuando una aplicación solicita acceso a la red." FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <CheckBox x:Name="SoundToggle" Grid.Column="2" Style="{StaticResource ModernToggleSwitch}" VerticalAlignment="Center" Click="SoundToggle_Click"/>
                            </Grid>

                            <!-- Row 3.1: Custom Sound File Selector & Preview -->
                            <Grid x:Name="CustomSoundRow" Margin="44,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Height="32" Padding="10,0" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="SoundPathDisplay" Text="(Predeterminado)" Foreground="{DynamicResource SubTextBrush}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Border>

                                <Button x:Name="BrowseSoundBtn" Grid.Column="1" Content="Examinar..." Height="32" Padding="12,5" Style="{StaticResource SecondaryButtonStyle}" Click="BrowseSound_Click" Margin="0,0,6,0"/>
                                <Button x:Name="ResetSoundBtn" Grid.Column="2" Content="Restablecer" Height="32" Padding="12,5" Style="{StaticResource SecondaryButtonStyle}" Click="ResetSound_Click" Margin="0,0,6,0"/>
                                <Button x:Name="PreviewSoundBtn" Grid.Column="3" Width="36" Height="32" Padding="0" ToolTip="Probar sonido" Style="{StaticResource SecondaryButtonStyle}" Click="PreviewSound_Click">
                                    <Path Data="M 6 4 L 16 10 L 6 16 Z" Fill="{DynamicResource AccentBrush}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1.5,0,0,0"/>
                                </Button>
                            </Grid>

                            <!-- Separator -->
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4,0,10"/>

                            <!-- Row 4: Test Notification Button Row -->
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Paper Plane / Send Icon -->
                                <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Path Data="M 2 2 L 18 9 L 2 16 L 5 9 Z" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.2" Fill="Transparent" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="TestTitleLbl" Text="Probar notificación" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock x:Name="TestDescLbl" Text="Envía un aviso para comprobar la posición y aspecto en pantalla." FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button x:Name="PreviewBtn" Grid.Column="2" Content="Vista previa" Height="32" Padding="16,6" Style="{StaticResource SecondaryButtonStyle}" Click="PreviewBtn_Click"/>
                            </Grid>

                            <!-- Separator -->
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,10,0,10"/>

                            <!-- Toast Notifications Subtitle -->
                            <TextBlock x:Name="ToastHdrLbl" Text="Notificaciones flotantes (Toast)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>

                            <!-- Toast 1: App Info (Version / Executable change) -->
                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Path Data="M 12 2 C 6.48 2 2 6.48 2 12 C 2 17.52 6.48 22 12 22 C 17.52 22 22 17.52 22 12 C 22 6.48 17.52 2 12 2 Z M 12 7 A 1.25 1.25 0 1 1 12 9.5 A 1.25 1.25 0 1 1 12 7 Z M 11 11 L 13 11 L 13 17 L 11 17 Z" Fill="{DynamicResource AccentBrush}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="ToastAppInfoTitleLbl" Text="Actualizaciones y cambios de aplicaciones" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock x:Name="ToastAppInfoDescLbl" Text="Muestra un aviso flotante cuando una aplicación cambia de versión o se recompila en disco." FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox x:Name="ToastAppInfoToggle" Grid.Column="2" Style="{StaticResource ModernToggleSwitch}" VerticalAlignment="Center" Click="ToastToggle_Click"/>
                            </Grid>

                            <!-- Toast 2: Internet Connection Lost / Restored -->
                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Path Data="M 12,19 L 12,19.01 M 8.5,15.5 C 10.5,13.8 13.5,13.8 15.5,15.5 M 5.5,12 C 9.2,8.5 14.8,8.5 18.5,12 M 2.5,8.5 C 8,3.5 16,3.5 21.5,8.5" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="Transparent"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="ToastInternetTitleLbl" Text="Corte y restablecimiento de internet" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock x:Name="ToastInternetDescLbl" Text="Muestra un aviso flotante si se corta o restablece la conexión a internet." FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox x:Name="ToastInternetToggle" Grid.Column="2" Style="{StaticResource ModernToggleSwitch}" VerticalAlignment="Center" Click="ToastToggle_Click"/>
                            </Grid>

                            <!-- Toast 3: Protection State Changed -->
                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Path Data="M 12,2 L 4,5 L 4,11 C 4,16.5 7.5,21.3 12,22.5 C 16.5,21.3 20,16.5 20,11 L 20,5 Z" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="Transparent"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="ToastProtectionTitleLbl" Text="Cambios de estado de protección" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock x:Name="ToastProtectionDescLbl" Text="Muestra un aviso flotante cuando activas o desactivas la protección." FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox x:Name="ToastProtectionToggle" Grid.Column="2" Style="{StaticResource ModernToggleSwitch}" VerticalAlignment="Center" Click="ToastToggle_Click"/>
                            </Grid>

                            <!-- Toast 4: Auto-Block Timeout -->
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Path Data="M 12,2 C 6.5,2 2,6.5 2,12 C 2,17.5 6.5,22 12,22 C 17.5,22 22,17.5 22,12 C 22,6.5 17.5,2 12,2 Z M 12,6 L 12,12 L 16,14" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="Transparent"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="ToastAutoBlockTitleLbl" Text="Bloqueo automático por tiempo" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock x:Name="ToastAutoBlockDescLbl" Text="Muestra un aviso flotante cuando una conexión sin responder se bloquea automáticamente." FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox x:Name="ToastAutoBlockToggle" Grid.Column="2" Style="{StaticResource ModernToggleSwitch}" VerticalAlignment="Center" Click="ToastToggle_Click"/>
                            </Grid>

                            <!-- Separator -->
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,10,0,10"/>

                            <!-- Traffic Animation Style Setting -->
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Path Data="M 3 17 L 9 11 L 13 15 L 21 7 M 21 7 L 16 7 M 21 7 L 21 12" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="Transparent"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="TrafficAnimTitleLbl" Text="Animación de flujo de tráfico" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock x:Name="TrafficAnimDescLbl" Text="Estilo visual del flujo de telemetría en tiempo real en la cabecera." FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox x:Name="TrafficAnimBox" Grid.Column="2" Width="180" Height="34" Style="{StaticResource ModernComboBox}" SelectionChanged="TrafficAnimBox_SelectionChanged"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- System & Startup Section -->
                    <TextBlock x:Name="SystemHdrLbl" Text="Sistema" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="14" Margin="0,18,0,8"/>

                    <Border CornerRadius="12" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16,12">
                        <StackPanel>
                            <!-- 1. Startup Item -->
                            <Grid MinHeight="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Startup Power Icon -->
                                <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Path Data="M 12 2 V 10 M 18.36 5.64 A 9 9 0 1 1 5.64 5.64" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="StartupTitleLbl" Text="Ejecutar al iniciar Windows" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock x:Name="StartupDescLbl" Text="Inicia CyberWall automáticamente al iniciar sesión en Windows." FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <CheckBox x:Name="StartupToggle" Grid.Column="2" Style="{StaticResource ModernToggleSwitch}" VerticalAlignment="Center" Click="StartupToggle_Click"/>
                            </Grid>

                            <!-- 1.1 Conditional Start Minimized Sub-item -->
                            <Grid x:Name="StartMinimizedRow" MinHeight="38" Margin="44,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="StartMinimizedTitleLbl" Text="Iniciar minimizado" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock x:Name="StartMinimizedDescLbl" Text="Inicia CyberWall oculto en la bandeja del sistema en lugar de abrir la ventana." FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox x:Name="StartMinimizedToggle" Grid.Column="1" Style="{StaticResource ModernToggleSwitch}" VerticalAlignment="Center" Click="StartMinimizedToggle_Click"/>
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,10"/>

                            <!-- 2. Minimize to Tray on Close Item -->
                            <Grid MinHeight="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Tray Dock Icon -->
                                <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Path Data="M 2 3 L 14 3 L 14 13 L 2 13 Z M 2 9 L 5 9 L 6 11 L 10 11 L 11 9 L 14 9" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="MinimizeToTrayTitleLbl" Text="Enviar a la bandeja al cerrar" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock x:Name="MinimizeToTrayDescLbl" Text="Oculta la ventana en la bandeja del sistema al presionar cerrar en lugar de salir." FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <CheckBox x:Name="MinimizeToTrayToggle" Grid.Column="2" Style="{StaticResource ModernToggleSwitch}" VerticalAlignment="Center" Click="MinimizeToTrayToggle_Click"/>
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,10"/>

                            <!-- 3. Auto-block unanswered prompts -->
                            <Grid MinHeight="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Path Data="M 12 3 A 9 9 0 1 1 3 12 M 12 7 V 12 L 15.5 14" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="AutoBlockTitleLbl" Text="Bloquear avisos sin respuesta" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock x:Name="AutoBlockDescLbl" Text="Si no respondes, el programa se bloquea automáticamente." FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <CheckBox x:Name="AutoBlockToggle" Grid.Column="2" Style="{StaticResource ModernToggleSwitch}" VerticalAlignment="Center" Click="AutoBlockToggle_Click"/>
                            </Grid>

                            <Grid x:Name="AutoBlockWaitRow" MinHeight="40" Margin="44,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="AutoBlockWaitLbl" Text="Esperar antes de bloquear" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <ComboBox x:Name="AutoBlockWaitBox" Grid.Column="1" Width="150" Height="34" Style="{StaticResource ModernComboBox}" SelectionChanged="AutoBlockWaitBox_SelectionChanged"/>
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,10"/>

                            <!-- 4. Clear all rules Item -->
                            <Grid MinHeight="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Trash Icon -->
                                <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Path Data="M 3 6 H 17 M 7 6 V 4 C 7 3.4 7.4 3 8 3 H 12 C 12.6 3 13 3.4 13 4 V 6 M 5 6 L 6 17 C 6 17.6 6.4 18 7 18 H 13 C 13.6 18 14 17.6 14 17 L 15 6" Stroke="#FF5555" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="ClearAllTitleLbl" Text="Limpiar todas las reglas" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock x:Name="ClearAllDescLbl" Text="Elimina todas las reglas de programas de la lista del firewall." FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button x:Name="ClearAllBtn" Grid.Column="2" Content="Limpiar reglas" Height="32" Padding="16,6" Style="{StaticResource SecondaryButtonStyle}" Click="ClearAllRules_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer (CyberSnap Style) -->
            <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,11,11" Padding="14,10">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                        <Image Source="pack://application:,,,/Assets/CyberWall.png" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="FooterVerText" Text="CyberWall 1.7.0" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="© 2026 CyberGems" FontSize="11" Foreground="{DynamicResource SubTextBrush}" Opacity="0.75" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
    </Border>
</Window>
