<Window x:Class="CyberWall.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="420" Width="480" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{DynamicResource BgBrush}" ShowInTaskbar="False" WindowStyle="SingleBorderWindow">
    <Grid Margin="0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <TextBlock x:Name="TitleLbl" Text="Configuración" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right" Background="Transparent" Foreground="{DynamicResource SubTextBrush}" BorderThickness="0" Click="Close_Click"/>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16,20,8">
            <StackPanel>
                <TextBlock x:Name="LangLbl" Text="Idioma" Foreground="{DynamicResource SubTextBrush}" FontSize="12" Margin="0,0,0,6"/>
                <ComboBox x:Name="LangBox" Height="34" SelectionChanged="Lang_Changed">
                    <ComboBoxItem Content="Español"/><ComboBoxItem Content="English"/>
                </ComboBox>
                <TextBlock x:Name="ThemeLbl" Text="Tema" Foreground="{DynamicResource SubTextBrush}" FontSize="12" Margin="0,16,0,6"/>
                <ComboBox x:Name="ThemeBox" Height="34" SelectionChanged="Theme_Changed">
                    <ComboBoxItem Content="CyberWall (default) — oscuro azulado"/>
                    <ComboBoxItem Content="Dark — oscuro neutro"/>
                    <ComboBoxItem Content="Light — claro"/>
                </ComboBox>
                <Border Margin="0,20,0,0" CornerRadius="10" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Vista previa" Foreground="{DynamicResource SubTextBrush}" FontSize="11"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Height="48" CornerRadius="8" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,6,0"/>
                            <Border Grid.Column="1" Height="48" CornerRadius="8" Background="{DynamicResource AccentBrush}" Margin="6,0,0,0">
                                <TextBlock Text="Accent" Foreground="{DynamicResource AccentFgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                        <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource SubTextBrush}" FontSize="10" Text="Cambia al instante sin reiniciar"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
            <Button x:Name="CloseBtn" Content="Cerrar" Width="110" Height="34" HorizontalAlignment="Right" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentFgBrush}" BorderThickness="0" Click="Close_Click"/>
        </Border>
    </Grid>
</Window>
