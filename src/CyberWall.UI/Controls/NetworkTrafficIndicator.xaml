<UserControl x:Class="CyberWall.UI.Controls.NetworkTrafficIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="390" Height="36"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <Border x:Name="RootBorder" CornerRadius="8" Padding="10,0"
            Background="{DynamicResource SearchBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="6" Height="6" Margin="0,0,7,0"
                         Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="LiveText" Foreground="{DynamicResource TextBrush}"
                           FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <Grid Grid.Column="1" Height="20" Margin="12,0,12,0" ClipToBounds="True"
                  VerticalAlignment="Center">
                <Border Height="1" VerticalAlignment="Center"
                        Background="{DynamicResource BorderBrush}" Opacity="0.8"/>
                <Canvas x:Name="TrafficCanvas" VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"/>
            </Grid>

            <TextBlock x:Name="StateText" Grid.Column="2"
                       Foreground="{DynamicResource AccentBrush}"
                       FontSize="10" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>
