<UserControl x:Class="CyberWall.UI.Controls.NetworkTrafficIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="540" Height="32"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.ToolTip>
        <ToolTip Background="{DynamicResource HeaderBgBrush}"
                 BorderBrush="{DynamicResource BorderLightBrush}"
                 BorderThickness="1" Padding="12,10"
                 HasDropShadow="True">
            <StackPanel Width="230">
                <!-- Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Path Data="M 12 2 L 2 6 L 2 13 C 2 19 6.5 24.5 12 26 C 17.5 24.5 22 19 22 13 L 22 6 Z" Width="12" Height="14" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" Margin="0,0,6,0"/>
                    <TextBlock x:Name="TooltipHeaderLbl" Text="Telemetría de Red en Vivo" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>

                <!-- Adapter Info -->
                <Grid Margin="0,2,0,4">
                    <TextBlock x:Name="TooltipAdapterLbl" Text="Adaptador:" FontSize="10" Foreground="{DynamicResource SubTextBrush}"/>
                    <TextBlock x:Name="TooltipAdapterVal" Text="Wi-Fi / Ethernet" HorizontalAlignment="Right" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" MaxWidth="140" TextTrimming="CharacterEllipsis"/>
                </Grid>

                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,3"/>

                <!-- Inbound Speed -->
                <Grid Margin="0,2">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 5 1.5 L 5 11 M 5 11 L 1.6 6.7 M 5 11 L 8.4 6.7" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="8" Height="9" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TooltipDownLbl" Text="Descarga:" FontSize="10" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="TooltipDownVal" Text="0.0 B/s" HorizontalAlignment="Right" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                </Grid>

                <!-- Outbound Speed -->
                <Grid Margin="0,2">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 5 11 L 5 1.5 M 5 1.5 L 1.6 5.8 M 5 1.5 L 8.4 5.8" Stroke="#22C55E" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="8" Height="9" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TooltipUpLbl" Text="Subida:" FontSize="10" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="TooltipUpVal" Text="0.0 B/s" HorizontalAlignment="Right" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                </Grid>

                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,3"/>

                <!-- Session Totals -->
                <Grid Margin="0,2">
                    <TextBlock x:Name="TooltipTotalDownLbl" Text="Recibido en sesión:" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}"/>
                    <TextBlock x:Name="TooltipTotalDownVal" Text="0 MB" HorizontalAlignment="Right" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}"/>
                </Grid>
                <Grid Margin="0,2">
                    <TextBlock x:Name="TooltipTotalUpLbl" Text="Enviado en sesión:" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}"/>
                    <TextBlock x:Name="TooltipTotalUpVal" Text="0 MB" HorizontalAlignment="Right" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}"/>
                </Grid>
                
                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,3"/>

                <!-- Filter State -->
                <Grid Margin="0,2">
                    <TextBlock x:Name="TooltipFilterLbl" Text="Estado del filtro:" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}"/>
                    <TextBlock x:Name="TooltipFilterVal" Text="Protegido" HorizontalAlignment="Right" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource BadgeAllowFgBrush}"/>
                </Grid>

                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,3"/>
                <TextBlock x:Name="TooltipClickHint" Text="Clic para ver historial de 60s" FontSize="9.5" FontStyle="Italic" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
        </ToolTip>
    </UserControl.ToolTip>

    <Border x:Name="RootBorder" CornerRadius="15" Padding="8,0,6,0"
            Background="{DynamicResource SearchBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            Cursor="Hand" MouseLeftButtonUp="RootBorder_MouseLeftButtonUp"
            ToolTipService.InitialShowDelay="200"
            ToolTipService.ShowDuration="15000">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- 0: Left Live Status Dot & Live Label -->
                <ColumnDefinition Width="Auto"/>
                <!-- 1: Real-time In/Out Speed Readouts (TrafficMonitor style with fixed non-jitter layout) -->
                <ColumnDefinition Width="Auto"/>
                <!-- 2: Dynamic Telemetry Flow Stream with edge masking -->
                <ColumnDefinition Width="*"/>
                <!-- 3: Right Status Badge Pill -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left Status Dot & Label -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,8,0">
                <Grid Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusHalo" Width="12" Height="12"
                             Fill="{DynamicResource AccentBrush}" Opacity="0.25"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Ellipse x:Name="StatusDot" Width="5.5" Height="5.5"
                             Fill="{DynamicResource AccentBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="LiveText" Foreground="{DynamicResource TextBrush}"
                           FontSize="9" FontWeight="Bold" VerticalAlignment="Center"
                           Opacity="0.85"/>
            </StackPanel>

            <!-- Real-Time Traffic Rates (Fixed-width container with zero layout jitter & vector arrows) -->
            <Border Grid.Column="1" Background="{DynamicResource CardSecondaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Width="184" Height="23" Margin="0,0,8,0" VerticalAlignment="Center">
                <Grid Margin="6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Download Column (Fixed Vector Arrow + Monospaced Tabular Speed) -->
                    <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="13"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="M 5 1.5 L 5 11 M 5 11 L 1.6 6.7 M 5 11 L 8.4 6.7"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="8" Height="9" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="1" x:Name="DownloadSpeedText" Text="0.0 B/s" Foreground="{DynamicResource TextBrush}"
                                   FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"
                                   FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, Roboto, sans-serif"
                                   Typography.NumeralAlignment="Tabular"/>
                    </Grid>

                    <!-- Divider Line -->
                    <Rectangle Grid.Column="1" Width="1" Height="11" Fill="{DynamicResource BorderBrush}" Opacity="0.6" VerticalAlignment="Center"/>

                    <!-- Upload Column (Fixed Vector Arrow + Monospaced Tabular Speed) -->
                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="4,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="13"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="M 5 11 L 5 1.5 M 5 1.5 L 1.6 5.8 M 5 1.5 L 8.4 5.8"
                              Stroke="#22C55E" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="8" Height="9" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="1" x:Name="UploadSpeedText" Text="0.0 B/s" Foreground="{DynamicResource TextBrush}"
                                   FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"
                                   FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, Roboto, sans-serif"
                                   Typography.NumeralAlignment="Tabular"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Dynamic Live Waveform Stream with Smooth Edge Masking -->
            <Grid Grid.Column="2" Height="20" Margin="4,0,8,0" ClipToBounds="True"
                  VerticalAlignment="Center">
                <Grid.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00000000" Offset="0.0"/>
                        <GradientStop Color="#FF000000" Offset="0.08"/>
                        <GradientStop Color="#FF000000" Offset="0.92"/>
                        <GradientStop Color="#00000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </Grid.OpacityMask>

                <!-- Soft Baseline Reference -->
                <Border Height="1" VerticalAlignment="Bottom" Margin="0,0,0,1"
                        Background="{DynamicResource BorderBrush}" Opacity="0.35"/>

                <!-- Wave Area and Stroke Paths -->
                <Canvas x:Name="TrafficWaveCanvas" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <Path x:Name="WaveAreaPath">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop x:Name="WaveGradientStop1" Color="#3038BDF8" Offset="0.0"/>
                                <GradientStop x:Name="WaveGradientStop2" Color="#0038BDF8" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>
                    <Path x:Name="WaveLinePath"
                          Stroke="{DynamicResource AccentBrush}"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"/>
                </Canvas>
            </Grid>

            <!-- Right Status Badge Pill -->
            <Border x:Name="StatePill" Grid.Column="3"
                    CornerRadius="8" Padding="6,2" VerticalAlignment="Center"
                    Background="{DynamicResource BadgeAllowBgBrush}"
                    BorderBrush="{DynamicResource BadgeAllowFgBrush}"
                    BorderThickness="1">
                <TextBlock x:Name="StateText"
                           Foreground="{DynamicResource BadgeAllowFgBrush}"
                           FontSize="9" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
