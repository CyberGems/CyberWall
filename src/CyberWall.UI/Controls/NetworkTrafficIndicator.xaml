<UserControl x:Class="CyberWall.UI.Controls.NetworkTrafficIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="360" Height="30"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <Border x:Name="RootBorder" CornerRadius="15" Padding="10,0,6,0"
            Background="{DynamicResource SearchBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left Status Dot with Ambient Halo and Live Label -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,0,0">
                <Grid Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusHalo" Width="14" Height="14"
                             Fill="{DynamicResource AccentBrush}" Opacity="0.25"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Ellipse x:Name="StatusDot" Width="6" Height="6"
                             Fill="{DynamicResource AccentBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="LiveText" Foreground="{DynamicResource TextBrush}"
                           FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center"
                           Opacity="0.9"/>
            </StackPanel>

            <!-- Dynamic Telemetry Flow Stream with Smooth Edge Masking -->
            <Grid Grid.Column="1" Height="16" Margin="10,0,10,0" ClipToBounds="True"
                  VerticalAlignment="Center">
                <Grid.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00000000" Offset="0.0"/>
                        <GradientStop Color="#FF000000" Offset="0.14"/>
                        <GradientStop Color="#FF000000" Offset="0.86"/>
                        <GradientStop Color="#00000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </Grid.OpacityMask>

                <!-- Soft Telemetry Baseline -->
                <Border Height="1" VerticalAlignment="Center"
                        Background="{DynamicResource BorderBrush}" Opacity="0.45">
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00000000" Offset="0.0"/>
                            <GradientStop Color="#FF000000" Offset="0.25"/>
                            <GradientStop Color="#FF000000" Offset="0.75"/>
                            <GradientStop Color="#00000000" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                </Border>

                <!-- Animated Data Packets Canvas -->
                <Canvas x:Name="TrafficCanvas" VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"/>
            </Grid>

            <!-- Right Status Badge Pill -->
            <Border x:Name="StatePill" Grid.Column="2"
                    CornerRadius="9" Padding="8,2" VerticalAlignment="Center"
                    Background="{DynamicResource BadgeAllowBgBrush}"
                    BorderBrush="{DynamicResource BadgeAllowFgBrush}"
                    BorderThickness="1">
                <TextBlock x:Name="StateText"
                           Foreground="{DynamicResource BadgeAllowFgBrush}"
                           FontSize="9.5" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
