<UserControl x:Class="CyberWall.UI.Controls.CountryFlagMark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="16">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid Width="20" Height="13" VerticalAlignment="Center">
            <Image x:Name="FlagImage" Width="20" Height="13" Stretch="Uniform"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   SnapsToDevicePixels="True" Visibility="Collapsed"/>
            <Border x:Name="UnknownFlagBorder" Width="20" Height="13" CornerRadius="2.5"
                    Background="#7DD3FC"
                    BorderBrush="#0284C7" BorderThickness="0.7"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    SnapsToDevicePixels="True" Visibility="Visible" ClipToBounds="True">
                <Viewbox Stretch="Uniform" Margin="1,0.5">
                    <Canvas Width="48" Height="32">
                        <Path Fill="#22C55E" Data="M 3,4 C 4,2 11,2 14,3.5 C 16,5 15,9 12,10.5 C 12,12.5 10,14 8,13.5 C 5,13.5 3.5,10 3,7 Z M 16,1.5 C 17.5,1.5 18,3 17,4 C 16,4 15,3 16,1.5 Z M 9,15 C 11,15 14,16.5 13.5,20 C 13,23.5 11,27 9.5,27 C 8,27 7.5,19 9,15 Z M 20,3.5 C 22,3 25,4 25,6 C 24,8 21,8 20,6.5 Z M 20,9.5 C 24,9.5 27,11.5 26,16 C 25,20 23,22.5 21.5,22.5 C 19.5,20.5 19,14 20,9.5 Z M 26,3.5 C 33,2.5 42,3.5 44,7 C 41,9.5 38,9 37,11.5 C 34,13.5 31,11.5 30,13 C 28,11 26.5,7 26,3.5 Z M 35,19 C 39.5,19 41,21.5 40,23.5 C 37,25 34.5,23.5 34.5,21.5 Z"/>
                    </Canvas>
                </Viewbox>
            </Border>
        </Grid>
        <Border x:Name="CountBadgeBorder" Margin="3,0,0,0" Padding="3,0" Height="13" CornerRadius="3"
                Background="{DynamicResource CardSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0.6"
                VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock x:Name="CountBadgeText" FontSize="8.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource SubTextBrush}"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>
    </StackPanel>
</UserControl>
