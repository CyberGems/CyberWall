<UserControl x:Class="CyberWall.UI.Controls.CountryFlagMark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="22" Height="16">
    <Grid>
        <Image x:Name="FlagImage" Width="20" Height="13" Stretch="Uniform"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               SnapsToDevicePixels="True" Visibility="Collapsed"/>
        <Path x:Name="GlobePath" Stretch="Uniform" Width="13" Height="13"
              Fill="Transparent" Stroke="{DynamicResource SubTextBrush}" StrokeThickness="1.6"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Data="M 12 2 A 10 10 0 1 0 12 22 A 10 10 0 1 0 12 2 M 2 12 H 22 M 12 2 C 16 6.5 16 17.5 12 22 M 12 2 C 8 6.5 8 17.5 12 22"/>
    </Grid>
</UserControl>
